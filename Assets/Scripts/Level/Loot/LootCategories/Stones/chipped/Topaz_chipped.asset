  lootName: "\u041D\u0430\u0434\u043A\u043E\u043B\u043E\u0442\u044B\u0439 \u0442\u043E\u043F\u0430\u0437"
  lootDesc: "\u041D\u0430\u0434\u043A\u043E\u043B\u043E\u0442\u044B\u0439 \u0442\u043E\u043F\u0430\u0437.
    \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043E\u0442\u043A\u043E\u043B\u043E\u0432\u0448\u0438\u0439\u0441\u044F
    \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442, \u0435\u0433\u043E, \u0441\u043A\u043E\u0440\u0435\u0435
    \u0432\u0441\u0435\u0433\u043E, \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F
    \u043F\u0440\u043E\u0434\u0430\u0442\u044C, \u0445\u043E\u0442\u044C \u0438 \u043F\u043E
    \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u0430\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439
    \u0446\u0435\u043D\u0435.\n\u041A\u0430\u043C\u0435\u043D\u044C \u043C\u043E\u0436\u043D\u043E
    \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432
    \u0442\u043E\u043F\u0430\u0437\u0430, \u043D\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D."
