    RefIds:
    - rid: 5720227232747880520
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0421 \u0432\u044B\u0445\u043E\u0434\u043E\u043C \u0432\u0435\u0440\u0441\u0438\u0438
          v23 \u043C\u043E\u0438 \u0445\u0443\u0434\u0448\u0438\u0435 \u043E\u043F\u0430\u0441\u0435\u043D\u0438\u044F
          \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438\u0441\u044C:
          \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F [\u0423\u0414\u0410\u041B\u0415\u041D\u041E]
          \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u043B\u0430\u0441\u044C
          \u043E\u0431 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0438 \u0441\u0432\u043E\u0438\u0445
          \u0440\u043E\u0431\u043E\u0442\u043E\u0432-\u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432.
          \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0448\u0438\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C
          \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
          \u043D\u043E\u0432\u044B\u0435 \u0442\u0430\u043A\u0442\u0438\u043A\u0438
          \u0441\u0431\u043E\u0440\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432,
          \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
          \u043D\u0430 \u043F\u0440\u0435\u0436\u043D\u0435\u043C \u0443\u0440\u043E\u0432\u043D\u0435.
          \u0417\u0434\u0435\u0441\u044C \u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
          \u043E\u0431 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u043D\u0430\u0448\u0438\u0445
          \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F\u0445."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880521
      type: {class: ArticlePartLink, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041A \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443 \u044D\u043A\u0440\u0430\u043D\u0443"
        article: {fileID: 11400000, guid: ab023004752cca84bb990b709c52f1e7, type: 2}
    - rid: 5720227232747880522
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443,
          \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u043F\u043E\u043D\u044F\u043B\u0430,
          \u0447\u0442\u043E \u0441\u0442\u0430\u0440\u044B\u0439 \u0418\u0418 \u0431\u044B\u043B
          \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0441\u0442
          \u0438 \u043B\u0435\u0433\u043A\u043E \u043E\u0431\u0445\u043E\u0434\u0438\u043B\u0441\u044F.
          \u0412\u0438\u0434\u0438\u043C\u043E, \u043E\u043D \u0431\u044B\u043B \u0432\u0441\u0435\u0433\u043E
          \u043B\u0438\u0448\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C
          \u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
          \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043C\u0435\u043D\u044F\u043B\u0438
          \u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880523
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0418\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0418\u0418
          \u0437\u0430\u0442\u0440\u043E\u043D\u0443\u043B\u0438 \u0434\u0432\u0430
          \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u043C\u043E\u043C\u0435\u043D\u0442\u0430:
          \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432 \u0438 \u0441\u043F\u043E\u0441\u043E\u0431
          \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u0442\u043E\u0447\u0435\u043A
          \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430. \u041D\u043E \u043E\u0431\u043E
          \u0432\u0441\u0435\u043C \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880524
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0434\u043B\u044F \u0418\u0418
          \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430
          \u0442\u0435\u0440\u043C\u0438\u043D \"\u043C\u0435\u0440\u044B \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438\".
          \u042D\u0442\u043E \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440, \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0439
          \u044D\u043D\u0435\u0440\u0433\u043E\u0437\u0430\u0442\u0440\u0430\u0442\u044B
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432: \u0447\u0435\u043C
          \u043C\u0435\u043D\u044C\u0448\u0435 \u0440\u0438\u0441\u043A\u0430 \u0434\u043B\u044F
          \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0439 \u043B\u043E\u043A\u0430\u0446\u0438\u0438,
          \u0442\u0435\u043C \u0432 \u0431\u043E\u043B\u0435\u0435 \u044D\u043D\u0435\u0440\u0433\u043E\u0441\u0431\u0435\u0440\u0435\u0433\u0430\u044E\u0449\u0435\u043C
          \u0440\u0435\u0436\u0438\u043C\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A. \u0415\u0441\u043B\u0438
          \u0440\u0438\u0441\u043A \u0434\u043B\u044F \u043B\u043E\u043A\u0430\u0446\u0438\u0438
          \u0432\u044B\u0441\u043E\u043A\u0438\u0439, \u0442\u043E \u0440\u043E\u0431\u043E\u0442
          \u0437\u0430\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0441\u0435
          \u0441\u0432\u043E\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438
          \u043F\u0430\u0442\u0440\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u0432
          \u043F\u043E\u043B\u043D\u0443\u044E \u0441\u0438\u043B\u0443."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880525
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0422\u0432\u043E\u0439 \"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\"
          \u0443\u043C\u0435\u0435\u0442 \u0432 \u0444\u043E\u043D\u043E\u0432\u043E\u043C
          \u0440\u0435\u0436\u0438\u043C\u0435 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u044C
          \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u0440\u0435\u0436\u0438\u043C
          \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430 \u0438 \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u044C
          \u0435\u0433\u043E \u043D\u0430 \u0432\u0438\u0437\u043E\u0440. \u0423\u0440\u043E\u0432\u0435\u043D\u044C
          \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
          \u043F\u043E\u0434 \u0448\u043A\u0430\u043B\u0430\u043C\u0438 \u0437\u0430\u0440\u044F\u0434\u0430
          \"\u0424\u043E\u043D\u0430\u0440\u044F\" \u0438 \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0430\"
          \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0438\u043A\u043E\u043D\u043E\u043A
          - \u0447\u0435\u043C \u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435,
          \u0442\u0435\u043C \u0432\u044B\u0448\u0435 \u043C\u0435\u0440\u0430 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880526
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412 \u0447\u0435\u043C \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
          \u044D\u0444\u0444\u0435\u043A\u0442 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438?
          \u0414\u043E \u043A\u043E\u043D\u0446\u0430 \u043D\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
          \u041D\u043E \u043D\u0430\u0448\u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u0438
          \u0443\u0436\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u043B\u0438,
          \u0447\u0442\u043E \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
          \u043C\u0435\u0440\u044B \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430:\n- \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430;\n- \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
          \u043E\u0431\u0437\u043E\u0440\u0430 \u0438 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
          \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F;\n-
          \u0432\u0440\u0435\u043C\u044F, \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043C\u043E\u0435
          \u0432 \u0444\u0430\u0437\u0435 3 (\u043E\u0441\u043C\u043E\u0442\u0440
          \u0442\u043E\u0447\u043A\u0438)."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880527
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0422\u0430\u043A\u0436\u0435 \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
          \u0443\u0440\u043E\u0432\u043D\u044F\u0445 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044E\u0442
          \u043D\u0430 \u043B\u044E\u0431\u044B\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
          \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F: \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435
          \u0438\u043B\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u043D\u0435
          \u0438\u043C\u0438 \u0434\u0432\u0435\u0440\u0438, \u0432\u0437\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0435
          \u0437\u0430\u043C\u043A\u0438 \u0438 \u0434\u0430\u0436\u0435 \u043D\u0430
          \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u0438\u0445 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438
          \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u043E\u0439
          \u043F\u043E\u043F\u044B\u0442\u043A\u0438. \u041A\u0442\u043E-\u0442\u043E
          \u0441\u043E\u043E\u0431\u0449\u0430\u043B, \u0447\u0442\u043E \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
          \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0443\u0440\u043E\u0432\u043D\u044F\u0445
          \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u0435\u0449\u0435 \u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043F\u043E
          \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C, \u043D\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0439
          \u044D\u0442\u043E\u043C\u0443 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0442,
          \u0430 \u0442\u0435, \u0447\u0442\u043E \u0435\u0441\u0442\u044C, \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442
          \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E - \u0442\u0430\u043A
          \u0447\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E\u0431
          \u044D\u0442\u043E\u043C \u0435\u0449\u0435 \u0440\u0430\u043D\u043E."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880528
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0421\u0430\u043C \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441
          \u0442\u043E\u0436\u0435 \u043D\u0435 \u0431\u044B\u043B \u0437\u0430\u0431\u044B\u0442:
          \u043C\u0435\u0440\u0430 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u0432\u043B\u0438\u044F\u0435\u0442 \u0438 \u043D\u0430 \u043D\u0435\u0433\u043E.
          \u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u0442\u043E\u0447\u043D\u043E \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430:\n-
          \u0432\u0440\u0435\u043C\u044F \u0434\u043E \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044F
          \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439;\n-
          \u0432\u0440\u0435\u043C\u044F \u0434\u043E \u0432\u044B\u043F\u0443\u0441\u043A\u0430
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432;\n- \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
          \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u044B\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432.\n\u0414\u0440\u0443\u0433\u0438\u0445
          \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432 \u043C\u044B \u043F\u043E\u043A\u0430
          \u0447\u0442\u043E \u043D\u0435 \u0432\u044B\u044F\u0432\u0438\u043B\u0438,
          \u043D\u043E \u0432\u0441\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C."
        fontSize: 18
        bold: 0
        italic: 0
