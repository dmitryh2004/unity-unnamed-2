      type: {class: ArticlePartLink, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041A \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443 \u044D\u043A\u0440\u0430\u043D\u0443"
        article: {fileID: 11400000, guid: ab023004752cca84bb990b709c52f1e7, type: 2}
    - rid: 1539561579184652377
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u043C
          \u0432\u0430\u0441 \u043D\u0430 \u043D\u0430\u0448\u0435\u0439 \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u043E\u0439
          \u0431\u0430\u0437\u0435 \u043E\u0442\u0434\u044B\u0445\u0430. \u0417\u0434\u0435\u0441\u044C
          \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0443\u0442\u044C
          \u043E\u0442 \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E
          \u0432\u044B\u043B\u0435\u0442\u0430, \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
          \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0438\u043B\u0438 \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C
          \u0441\u0432\u043E\u0435 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435.
          \u041D\u043E \u043E\u0431\u043E \u0432\u0441\u0435\u043C \u043F\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0443."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561579184652378
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041D\u0430\u0447\u043D\u0435\u043C \u0441 \u0441\u0430\u043C\u043E\u0433\u043E
          \u0432\u0430\u0436\u043D\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
          - \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u043A\u0443\u043F\u043B\u0438-\u043F\u0440\u043E\u0434\u0430\u0436\u0438
          \"\u0420\u044B\u043D\u043E\u043A 2.0\". \u042D\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
          - \u0432\u0430\u0448 \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A
          \u0432 \u043E\u0431\u0449\u0435\u043D\u0438\u0438 \u0441 \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C\u0438
          \u0438 \u041E\u0442\u0434\u0435\u043B\u043E\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438.
          \u041E\u043D\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
          \u0432\u0430\u043C \u0441\u0434\u0430\u0442\u044C \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435
          \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u043B\u0435\u0442\u0430
          \u0432\u0435\u0449\u0438 \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
          \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043F\u0440\u0438\u0435\u043C\u043D\u0438\u043A
          \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u0430\u0436\u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u0443
          \u0438\u043B\u0438 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435; \u0447\u0435\u0440\u0435\u0437
          \u043D\u0435\u0433\u043E \u0442\u0430\u043A\u0436\u0435 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
          \u0441\u0434\u0430\u0442\u044C \u0441\u0432\u043E\u0435 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435
          \u043D\u0430 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561579184652379
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0422\u0435\u0440\u043C\u0438\u043D\u0430\u043B, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
          \u0432\u044B \u0441\u0435\u0439\u0447\u0430\u0441 \u0447\u0438\u0442\u0430\u0435\u0442\u0435
          \u044D\u0442\u0443 \u0437\u0430\u043C\u0435\u0442\u043A\u0443, \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
          \u0442\u043E\u0447\u043A\u043E\u0439 \u0434\u043E\u0441\u0442\u0443\u043F\u0430
          \u043A \u0431\u0430\u0437\u0435 \u0437\u043D\u0430\u043D\u0438\u0439 \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0438,
          \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0435\u0439
          \u0432\u0430\u043C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
          \u043E \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0438 \u0438
          \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044F\u0445
          \u043D\u0430 \u043B\u043E\u043A\u0430\u0446\u0438\u044F\u0445. \u041E\u0437\u043D\u0430\u043A\u043E\u043C\u044C\u0442\u0435\u0441\u044C
          \u0441 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0441\u0442\u0430\u0442\u044C\u044F\u043C\u0438,
          \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B\u043C
          \u043A \u043B\u044E\u0431\u044B\u043C \u0441\u043E\u0431\u044B\u0442\u0438\u044F\u043C."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561579184652380
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412 \u0443\u0433\u043B\u0443 \u0441\u0442\u043E\u0438\u0442 \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0439
          \u0441\u0442\u043E\u043B. \u0421 \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u044C\u044E
          \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C
          \u043A\u0443\u0441\u043A\u0438 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0445
          \u043A\u0430\u043C\u043D\u0435\u0439 \u0432 \u043A\u0440\u0443\u0433\u043B\u044B\u0435
          \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438, \u0430 \u0438\u0445
          - \u043E\u0433\u0440\u0430\u043D\u0438\u0442\u044C \u0432 \u0431\u043E\u043B\u0435\u0435
          \u0434\u043E\u0440\u043E\u0433\u0438\u0435 \u0432\u0435\u0440\u0441\u0438\u0438
          \u043A\u0430\u043C\u043D\u0435\u0439. \u0422\u0430\u043A\u0436\u0435 \u0432
          \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u043C
          \u0440\u0435\u0436\u0438\u043C\u0435 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
          \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
          \u0431\u0440\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043E\u043A
          \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432
          \u043A\u0430\u043C\u043D\u0435\u0439."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561579184652381
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412 \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
          \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
          \u0441\u0443\u043D\u0434\u0443\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C
          \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435\u043C \u0434\u043B\u044F
          \u0442\u0435\u0445 \u0432\u0435\u0449\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
          \u0432\u044B \u0432 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
          \u0445\u043E\u0442\u0438\u0442\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
          \u043D\u0430 \u043F\u043E\u0442\u043E\u043C. \u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439
          \u043F\u043E \u043E\u0431\u044A\u0435\u043C\u0443 \u043E\u043D \u043D\u0435
          \u0438\u043C\u0435\u0435\u0442 \u0438\u0437-\u0437\u0430 \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
          \u043C\u043E\u0434\u0443\u043B\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u0437\u0430\u0434\u0430\u0435\u0442 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0439
          \u0440\u0430\u0437\u043C\u0435\u0440 \u0432\u0441\u0435\u043C \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u043C\u044B\u043C
          \u0432 \u0441\u0443\u043D\u0434\u0443\u043A \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C.
          \u0412 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
          \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0439
          \u043E\u0431\u044A\u0435\u043C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
          1 \u043A\u0443\u0431\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440,
          \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432 \u0441\u0443\u043D\u0434\u0443\u043A
          \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u043C\u043E\u0436\u043D\u043E
          \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0442\u044B\u0441\u044F\u0447\u0443
          \u0432\u0435\u0449\u0435\u0439."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561579184652382
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0421\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u0437\u0434\u0430\u043D\u0438\u044F,
          \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0432\u044B \u0441\u0435\u0439\u0447\u0430\u0441
          \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C, \u0435\u0441\u0442\u044C
          \u043E\u0434\u0438\u043D \u0440\u043E\u0431\u043E\u0442 \u0442\u0438\u043F\u0430
          \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A-2\". \u042D\u0442\u043E
          \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0435\u043C\u043D\u043E\u0433\u0438\u0445
          \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
          \u0440\u043E\u0431\u043E\u0442\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
          \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
          \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
          \u043E\u043D \u0432\u043C\u0435\u0441\u0442\u043E \u043F\u0430\u0442\u0440\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
          \u043B\u043E\u043A\u0430\u0446\u0438\u0438 \u0438 \u043F\u043E\u0438\u043C\u043A\u0438
          \u043D\u0430\u0448\u0438\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
          \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u044C
          \u043B\u0443\u043D\u043D\u0443\u044E \u043F\u043E\u0445\u043E\u0434\u043A\u0443."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561579184652383
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041D\u0430 \u044D\u0442\u043E\u043C \u044D\u043A\u0441\u043A\u0443\u0440\u0441\u0438\u044F
          \u0437\u0430\u043A\u043E\u043D\u0447\u0435\u043D\u0430. \u041F\u043E \u0432\u0441\u0435\u043C
          \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0438\u043C \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C
          \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
          \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0443
          \u0438\u043B\u0438 \u043F\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u043C\u0443
          \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443 \u2588(\u2588\u2588\u2588)\u2588\u2588\u2588-\u2588\u2588-\u2588\u2588."
