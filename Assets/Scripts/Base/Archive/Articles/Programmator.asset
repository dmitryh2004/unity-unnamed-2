    - rid: 3026835168771440654
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042D\u0442\u043E\u0442 \u0431\u043E\u043D\u0443\u0441 \u043F\u0440\u0438
          \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
          \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
          \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
          \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0430 50%, \u043E\u043A\u0440\u0443\u0433\u043B\u044F\u044F
          \u0438\u0442\u043E\u0433\u043E\u0432\u043E\u0435 \u0447\u0438\u0441\u043B\u043E
          \u0434\u043E \u0446\u0435\u043B\u043E\u0433\u043E \u0432 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
          \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E
          \u0434\u043B\u044F \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0437\u0430\u0449\u0438\u0442\u044B,
          \"\u0440\u0430\u0437\u0434\u0443\u0442\u044B\u0445\" \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u044B\u043C\u0438
          \u0443\u0437\u043B\u0430\u043C\u0438."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835168771440655
