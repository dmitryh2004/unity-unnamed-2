    - rid: 3026835165033791612
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0418\u043C\u0435\u0435\u0442 \u0441\u0440\u0435\u0434\u043D\u0438\u0439
          \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B (\u0434\u043E 80
          \u0435\u0434.) \u0438 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u043E\u0441\u0442\u044C
          (\u0434\u043E 50 \u0435\u0434.). \u042D\u0442\u043E\u0442 \u0443\u0437\u0435\u043B
          \u043A\u0430\u0436\u0434\u044B\u0439 \u0445\u043E\u0434 \u0431\u0443\u0434\u0435\u0442
          \u0441\u043D\u0438\u0436\u0430\u0442\u044C \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
          \u0442\u0432\u043E\u0435\u0433\u043E \u0432\u0438\u0440\u0443\u0441\u0430
          (\u0434\u043E 3 \u0435\u0434. \u0437\u0430 \u0445\u043E\u0434). \u042D\u0442\u0438
          \u0443\u0437\u043B\u044B \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E
          \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443,
          \u043D\u043E \u043D\u0435 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
          - \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0434\u043B\u044F
          \u044D\u0442\u043E\u0433\u043E \u0431\u043E\u043D\u0443\u0441\u044B."
        fontSize: 18
        bold: 0
        italic: 0
