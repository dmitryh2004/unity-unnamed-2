    - rid: 6553496767108218975
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412 \u044D\u0442\u043E\u0439 \u0444\u0430\u0437\u0435 \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\"
          \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
          \u0438 \u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
          \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
          \u0441\u0432\u043E\u044E \u0433\u043E\u043B\u043E\u0432\u0443 \u0434\u043B\u044F
          \u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438.
          \u0415\u0441\u043B\u0438 \u043E\u043D \u0437\u0430\u043C\u0435\u0442\u0438\u0442
          \u0438\u0433\u0440\u043E\u043A\u0430, \u0442\u043E \u043F\u0435\u0440\u0435\u0439\u0434\u0435\u0442
          \u0432 \u0444\u0430\u0437\u0443 2.\n\u041F\u043E \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0438
          \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
          \u0440\u043E\u0431\u043E\u0442 \u043F\u0435\u0440\u0435\u0439\u0434\u0435\u0442
          \u0432 \u0444\u0430\u0437\u0443 1."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218976
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0423\u0437\u043D\u0430\u0442\u044C, \u0432 \u043A\u0430\u043A\u043E\u0439
          \u0444\u0430\u0437\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
          \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\", \u043C\u043E\u0436\u043D\u043E
          \u043F\u043E \u0435\u0433\u043E \"\u0433\u043B\u0430\u0437\u0443\". \u0412
          \u0444\u0430\u0437\u0435 1 \u043E\u043D \u0431\u0443\u0434\u0435\u0442
          \u0441\u0432\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0441\u0438\u043D\u0438\u043C,
          \u0432 \u0444\u0430\u0437\u0435 2 - \u043A\u0440\u0430\u0441\u043D\u044B\u043C,
          \u0430 \u0432 \u0444\u0430\u0437\u0435 3 - \u0436\u0435\u043B\u0442\u044B\u043C."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218977
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0415\u0441\u043B\u0438 \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0443\"
          \u0443\u0434\u0430\u0441\u0442\u0441\u044F \u0434\u043E\u0433\u043D\u0430\u0442\u044C
          \u0432\u0430\u0441, \u0442\u043E \u043E\u043D \u0432\u044B\u0440\u0443\u0431\u0438\u0442
          \u0432\u0430\u0441 \u0441\u0432\u043E\u0438\u043C \u0443\u0434\u0430\u0440\u043E\u043C.
          \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
          \u0432\u0430\u0441 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u0435\u0442,
          \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
          \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430,
          \u043D\u043E \u0431\u0435\u0437 \u0432\u0435\u0449\u0435\u0439 \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435,
          \u0442\u0430\u043A \u0447\u0442\u043E \u0431\u0443\u0434\u044C\u0442\u0435
          \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218978
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438
          \u0441\u043E\u043E\u0431\u0449\u0430\u044E\u0442, \u0447\u0442\u043E \u043D\u0430
          \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
          \u0432\u044B\u0448\u043B\u0430 \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F
          \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432\" \u0441
          \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u043C \u0418\u0418.
          \u041E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
          \u0441\u0432\u043E\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043D\u0430
          \u043E\u0441\u043D\u043E\u0432\u0435 \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u043E\u0432
          \u0437\u0430\u0447\u0438\u0441\u0442\u043A\u0438 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430
          \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u043C, \u0430
          \u0442\u0430\u043A\u0436\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442
          \u043D\u0430 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432
          \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u0434\u0432\u0435\u0440\u0435\u0439,
          \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
          \u0437\u0430\u043C\u043A\u043E\u0432, \u0430 \u0442\u0430\u043A\u0436\u0435
          \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u043B\u0435\u0436\u0430\u0449\u0438\u0435
          \u043D\u0430 \u043F\u043E\u043B\u0443 \u0432\u0435\u0449\u0438. \u041F\u0440\u0430\u0432\u0434\u0430
          \u044D\u0442\u043E \u0438\u043B\u0438 \u043D\u0435\u0442, \u044F \u043D\u0435
          \u0437\u043D\u0430\u044E."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 1, b: 1, a: 1}
        textAlignment: 0
