    - rid: 5720227232747880529
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
        fontSize: 18
        bold: 1
        italic: 0
        underline: 1
        color: {r: 0, g: 0.75, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880530
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
          \u0442\u043E\u0447\u0435\u043A \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430"
        fontSize: 18
        bold: 1
        italic: 0
        underline: 1
        color: {r: 0, g: 0.75, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880531
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0417\u0434\u0435\u0441\u044C \u0432\u0441\u0435 \u043D\u0430\u043C\u043D\u043E\u0433\u043E
          \u0441\u043B\u043E\u0436\u043D\u0435\u0435. \u041F\u043E\u043D\u044F\u0442\u043D\u043E,
          \u0447\u0442\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
          \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F, \u043D\u043E \u043F\u043E\u043A\u0430
          \u0447\u0442\u043E \u0443\u043B\u043E\u0432\u0438\u0442\u044C \u0437\u0430\u043A\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0441\u0442\u044C
          \u043C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C. \u0412\u0441\u0435,
          \u0447\u0442\u043E \u043C\u043E\u0433\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
          - \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
          \u0431\u044B\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435
          \u0438 \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435
          \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435
          \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u0432."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 5720227232747880532
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0422\u0430\u043A\u0436\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
          \u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u044F
          \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430 \u0434\u0435\u043B\u0430\u0442\u044C
          \u043F\u0430\u043D\u0435\u043B\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
          \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u043C: \u043F\u0440\u0438 \u0432\u044B\u0431\u043E\u0440\u0435
          \u043B\u043E\u043A\u0430\u0446\u0438\u0438 \u0432\u0440\u0435\u043C\u044F
          \u0434\u043E \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044F \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439
          \u0438 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
          \u0431\u0443\u0434\u0443\u0442 \u0441\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u044B
          \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u043E\u0439
          \u043C\u0435\u0440\u0435 \u0431\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
          \u043D\u0430 \u044D\u0442\u043E\u0439 \u043B\u043E\u043A\u0430\u0446\u0438\u0438."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
