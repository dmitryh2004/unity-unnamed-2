      data:
        text: "\u041A \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443 \u044D\u043A\u0440\u0430\u043D\u0443"
        article: {fileID: 11400000, guid: ab023004752cca84bb990b709c52f1e7, type: 2}
    - rid: 3026835165033791609
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0421\u0430\u043C\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0435
          \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u0437\u0430\u0449\u0438\u0442\u044B,
          \u0438\u043C\u0435\u0435\u0442 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
          \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B (\u0434\u043E 110
          \u0435\u0434.) \u0438 \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u043E\u0441\u0442\u044C
          (20 \u0435\u0434.). \u041E\u0441\u043E\u0431\u044B\u0445 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439
          \u043D\u0435 \u0438\u043C\u0435\u0435\u0442. \u0415\u0433\u043E \u043F\u0440\u043E\u0449\u0435
          \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
          \u0447\u0435\u043C \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442\u044C
          - \u043E\u0434\u043D\u0430\u043A\u043E \u0442\u0432\u043E\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
          \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u0432\u0438\u0441\u0435\u0442\u044C
          \u043E\u0442 \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438."
