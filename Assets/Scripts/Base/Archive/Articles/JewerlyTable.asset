  header: "\u042E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0439 \u0441\u0442\u043E\u043B"
  articleParts:
  - rid: 6553496767108218880
  - rid: 6553496767108218881
  - rid: 6553496767108218882
  - rid: 6553496767108218883
  - rid: 6553496767108218884
  - rid: 6553496767108218885
  references:
    version: 2
    RefIds:
    - rid: 6553496767108218880
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0439 \u0441\u0442\u043E\u043B
          - \u0432\u0435\u0441\u044C\u043C\u0430 \u0447\u0443\u0434\u043D\u0430\u044F
          \u0432\u0435\u0449\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
          \u0432 \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u043D\u0435 \u0442\u0430\u043A
          \u0443\u0436 \u0438 \u0434\u0430\u0432\u043D\u043E. \u0418\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438
          \u0432 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0438 \u0441\u0432\u044F\u0437\u0430\u043D\u044B
          \u0441 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0448\u0438\u043C\u0438\u0441\u044F
          \u0437\u0430\u0442\u0440\u0430\u0442\u0430\u043C\u0438 \u043D\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
          \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
          \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0438, \u0447\u0442\u043E \u0432\u044B\u043B\u0438\u043B\u043E\u0441\u044C
          \u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u043A\u0432\u043E\u0442
          \u0434\u043B\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218881
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0446\u0435\u043B\u044C
          \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0430
          - \u043E\u0433\u0440\u0430\u043D\u043A\u0430 \u043D\u0435\u0434\u043E\u0440\u043E\u0433\u0438\u0445
          \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043E\u043A \u043A\u0430\u043C\u043D\u0435\u0439,
          \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u043C\u044B\u0445 \u0432
          \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430\u0445 \u0432 \u0431\u043E\u043B\u044C\u0448\u043E\u043C
          \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435, \u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435
          \u0438\u0437 \u043D\u0438\u0445 \u0440\u0435\u0434\u043A\u0438\u0445 \u0438
          \u0446\u0435\u043D\u043D\u044B\u0445 \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0445
          \u0438\u0437\u0434\u0435\u043B\u0438\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
          \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C
          \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0434\u043E\u0440\u043E\u0436\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218882
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041D\u0430\u0448\u0430 \u043C\u043E\u0434\u0435\u043B\u044C \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u043E\u0433\u043E
          \u0441\u0442\u043E\u043B\u0430 \u043D\u0435 \u043E\u0431\u043E\u0448\u043B\u0430\u0441\u044C
          \u0431\u0435\u0437 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u0439
          - \u0441 \u0435\u0435 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043C\u043E\u0436\u043D\u043E
          \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
          \u0431\u0440\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0435
          \u043A\u0430\u043C\u043D\u0438 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
          \u0438\u0445 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432. \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F
          \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
          \u043A\u0430\u043C\u043D\u0435\u0439 \u043F\u043E\u043A\u0430 \u0447\u0442\u043E
          \u0435\u0449\u0435 \u0441\u044B\u0440\u043E\u0432\u0430\u0442\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
          \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043D\u0435 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D.
          \u0422\u0430\u043A\u0436\u0435 \u0432\u0435\u0434\u0443\u0442\u0441\u044F
          \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B
          \u043F\u043E \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0435
          \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432 \u043A\u0430\u043C\u043D\u0435\u0439
          \u0432 \u043D\u0435\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435,
          \u043D\u043E \u043F\u043E\u043A\u0430 \u0447\u0442\u043E \u043E\u0431 \u044D\u0442\u043E\u043C
          \u0435\u0449\u0435 \u0440\u0430\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218883
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0435 \u0441\u0442\u043E\u043B\u044B
          \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
          \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C \u0432
          \u0431\u0430\u0437\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u0430\u0446\u0438\u0438.
          \u0417\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0443\u044E (\u0438,
          \u043A \u0441\u043B\u043E\u0432\u0443, \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
          \u0431\u043E\u043B\u044C\u0448\u0443\u044E) \u043F\u043B\u0430\u0442\u0443
          \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u0443\u043B\u0443\u0447\u0448\u0430\u0442\u044C,
          \u043F\u043E\u0432\u044B\u0448\u0430\u044F \u0448\u0430\u043D\u0441\u044B
          \u043D\u0430 \u0443\u0441\u043F\u0435\u0448\u043D\u0443\u044E \u043E\u0433\u0440\u0430\u043D\u043A\u0443
          \u0438 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
          \u043A\u0430\u043C\u043D\u0435\u0439."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218884
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041F\u043E \u0441\u0432\u043E\u0435\u043C\u0443 \u043E\u043F\u044B\u0442\u0443
          \u0441\u043A\u0430\u0436\u0443, \u0447\u0442\u043E \u043D\u0430 \u043D\u0438\u0437\u043A\u0438\u0445
          \u0443\u0440\u043E\u0432\u043D\u044F\u0445 \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u043E\u0433\u043E
          \u0441\u0442\u043E\u043B\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C,
          \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
          \u044D\u0442\u043E \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
          \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
          \u0431\u0440\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043A\u0430\u043C\u043D\u0438
          \u0438 \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438
          \u0438\u0437 \u043D\u0435\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0445.
          \u041C\u043E\u0436\u043D\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
          \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u043E\u0433\u0440\u0430\u043D\u0438\u0442\u044C
          \u043A\u0430\u043C\u0435\u043D\u044C, \u043D\u043E \u0432 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0435
          \u0441\u043B\u0443\u0447\u0430\u0435\u0432 \u043E\u043D \u043B\u0438\u0431\u043E
          \u0441\u0442\u0430\u043D\u0435\u0442 \u0431\u0440\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u043C,
          \u043B\u0438\u0431\u043E \u0440\u0430\u0441\u0441\u044B\u043F\u0435\u0442\u0441\u044F
          \u043D\u0430 \u043E\u0441\u043A\u043E\u043B\u043A\u0438."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218885
      type: {class: ArticlePartLink, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041A \u0433\u043B\u0430\u0432\u043D\u043E\u043C\u0443 \u044D\u043A\u0440\u0430\u043D\u0443"
