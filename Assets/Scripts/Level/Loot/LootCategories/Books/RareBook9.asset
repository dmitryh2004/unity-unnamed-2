  lootDesc: "\u0423\u0447\u0435\u0431\u043D\u0438\u043A \u043F\u043E \u043C\u0435\u043C\u043E\u043B\u043E\u0433\u0438\u0438,
    \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u043E
    \u043C\u0435\u043C\u0430\u0445 \u043A\u043E\u043D\u0446\u0430 20 - \u043D\u0430\u0447\u0430\u043B\u0430
    21 \u0432\u0435\u043A\u0430. \u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E
    \u0440\u0435\u0434\u043A\u0430\u044F \u043A\u043D\u0438\u0433\u0430, \u0437\u0430
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438
    \u0433\u043E\u0442\u043E\u0432\u044B \u0434\u0430\u0442\u044C \u043D\u0435\u043F\u043B\u043E\u0445\u0438\u0435
    \u0434\u0435\u043D\u044C\u0433\u0438.\n\n\u0422\u0440\u0435\u0442\u044C\u0435
    \u0438\u0437\u0434\u0430\u043D\u0438\u0435 \u044D\u0442\u043E\u0439 \u043A\u043D\u0438\u0433\u0438
    \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 3 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F
    \u0435\u0433\u0438\u043F\u0435\u0442\u0441\u043A\u043E\u0439 \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u044B
    \u0441 \u0440\u0430\u0437\u043D\u044B\u0445 \u0440\u0430\u043A\u0443\u0440\u0441\u043E\u0432,
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u0447\u0435\u0433\u043E \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F
    \u0438\u0433\u0440\u0430 \u0441\u043B\u043E\u0432 \"pyramid\" - \"pyraright\"
    - \"pyraleft\". \u0417\u0430 \u044D\u0442\u0443 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C
