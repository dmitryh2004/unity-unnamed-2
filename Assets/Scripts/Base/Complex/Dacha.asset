  complexName: "\u0417\u0430\u0433\u043E\u0440\u043E\u0434\u043D\u044B\u0439 \u0434\u043E\u043C"
  description: "\u041D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
    \u043D\u0438\u0447\u0435\u043C \u043D\u0435 \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0439\u0441\u044F
    \u0434\u0432\u0443\u0445\u044D\u0442\u0430\u0436\u043D\u044B\u0439 \u0434\u043E\u043C,
    \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0439\u0441\u044F \u0432 [\u0423\u0414\u0410\u041B\u0415\u041D\u041E].
    \u041E\u0434\u043D\u0430\u043A\u043E, \u043F\u043E \u043D\u0430\u0448\u0438\u043C
    \u0434\u0430\u043D\u043D\u044B\u043C, \u043E\u043D - \u0432\u0441\u0435\u0433\u043E
    \u043B\u0438\u0448\u044C \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0438\u0435
    \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430, \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u043E\u0433\u043E
    \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439 [\u0423\u0414\u0410\u041B\u0415\u041D\u041E]."
