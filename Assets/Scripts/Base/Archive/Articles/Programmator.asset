    - rid: 3026835165033791574
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0442\u0435\u0431\u0435
          \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E
          \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043D\u0435\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0435
          \u0443\u0437\u043B\u044B \u0441\u0435\u0442\u043A\u0438. \u041F\u0440\u0438
          \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0438 \u043D\u0435\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
          \u0443\u0437\u043B\u0430, \u0435\u0441\u043B\u0438 \u043E\u043D \u043F\u0443\u0441\u0442\u043E\u0439,
          \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u043E
          \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0434\u043E
          \u0443\u0437\u043B\u0430 \u0438\u043B\u0438 \u0431\u043E\u043D\u0443\u0441\u0430
          \u0432 \u0448\u0430\u0433\u0430\u0445 (\u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
          \u0447\u0438\u0441\u043B\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
          \u0442\u0430\u043C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
          - 5). \u0415\u0441\u043B\u0438 \u0432 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u043E\u043C
          \u0443\u0437\u043B\u0435 \u0447\u0442\u043E-\u0442\u043E \u0435\u0441\u0442\u044C,
          \u0442\u043E \u043E\u043D\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
          \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435 \u0432\u0437\u043B\u043E\u043C\u0430
          - \u0441 \u043D\u0438\u043C \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u043D\u043E
          \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        textAlignment: 0
    - rid: 3026835165033791575
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0438
          \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
          \u0443\u0437\u043B\u0430 \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0443\u0442
          \u043C\u0435\u0448\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
          \u0437\u0430\u0449\u0438\u0442\u044B. \n\u0412\u043E-\u043F\u0435\u0440\u0432\u044B\u0445,
          \u043F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
          \u043E\u043D\u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442
          \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u043A\u043B\u0435\u0442\u043A\u0438,
          \u0435\u0441\u043B\u0438:\n- \u043E\u043D\u0438 \u043D\u0435\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u044B;\n-
          \u0438\u043B\u0438 \u0435\u0441\u043B\u0438 \u0432 \u043D\u0435\u0439 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
          \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439
          \u0443\u0437\u0435\u043B (\u0442.\u0435. \u0435\u0433\u043E \u0430\u0442\u0430\u043A\u0430
          \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430, \u043F\u043E\u043A\u0430
          \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0438\u043C \u0435\u0441\u0442\u044C
          \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0437\u0430\u0449\u0438\u0442\u044B).\n\u0412\u043E-\u0432\u0442\u043E\u0440\u044B\u0445,
          \u0443 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430
          \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0437\u0430\u0449\u0438\u0442\u044B
          \u0435\u0441\u0442\u044C \u0438 \u0441\u0432\u043E\u0439 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
          \u044D\u0444\u0444\u0435\u043A\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u0442\u0435\u043C \u0441\u0438\u043B\u044C\u043D\u0435\u0435, \u0447\u0435\u043C
          \u0432\u044B\u0448\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          \u0437\u0430\u043C\u043A\u0430.\n\u0422\u0438\u043F\u044B \u0441\u0440\u0435\u0434\u0441\u0442\u0432
          \u0437\u0430\u0449\u0438\u0442\u044B \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
          \u043D\u0438\u0436\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        textAlignment: 0
