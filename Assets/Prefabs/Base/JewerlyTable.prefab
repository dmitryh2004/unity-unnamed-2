  m_Options:
    m_Options:
    - m_Text: "1. \u041D\u0435\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439
        - \u043A\u0440\u0443\u0433\u043B\u044B\u0439"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: "2. \u041D\u0430\u0434\u043A\u043E\u043B\u043E\u0442\u044B\u0439 -
        \u043A\u0440\u0443\u0433\u043B\u044B\u0439"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: "3. \u0422\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0438\u0439 -
        \u043A\u0440\u0443\u0433\u043B\u044B\u0439"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: "4. \u041A\u0440\u0443\u0433\u043B\u044B\u0439 - \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0439"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: "5. \u041A\u0440\u0443\u0433\u043B\u044B\u0439 - \u0448\u0435\u0441\u0442\u0438\u0433\u0440\u0430\u043D\u043D\u044B\u0439"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: "6. \u041A\u0440\u0443\u0433\u043B\u044B\u0439 - \u0432\u043E\u0441\u044C\u043C\u0438\u0433\u0440\u0430\u043D\u043D\u044B\u0439"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: "7. \u041A\u0440\u0443\u0433\u043B\u044B\u0439 - \u043A\u0430\u043F\u043B\u0435\u0432\u0438\u0434\u043D\u044B\u0439
        \u0433\u0440\u0430\u043D\u0435\u043D\u044B\u0439"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
    - m_Text: "8. \u041A\u0443\u0431\u0438\u043A \u0420\u0443\u0431\u0438\u043A\u0430"
      m_Image: {fileID: 0}
      m_Color: {r: 1, g: 1, b: 1, a: 1}
