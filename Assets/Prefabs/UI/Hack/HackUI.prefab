  m_Name: 
  m_EditorClassIdentifier: 
  playerInput: {fileID: 0}
  hackUIAnimator: {fileID: 4230397354405220621}
  emptyVisitedNodeTitle: "\u041E\u0431\u0435\u0437\u0432\u0440\u0435\u0436\u0435\u043D\u043D\u044B\u0439
    \u0443\u0437\u0435\u043B"
  UnvisitedNodeTitle: "\u041D\u0435\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0443\u0437\u0435\u043B"
  emptyVisitedNodeText: "\u0414\u0430\u043D\u043D\u044B\u0439 \u0443\u0437\u0435\u043B
    \u0443\u0436\u0435 \u0431\u044B\u043B \u043E\u0431\u0435\u0437\u0432\u0440\u0435\u0436\u0435\u043D
    \u0438 \u043D\u0435 \u043D\u0435\u0441\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u043E\u0439
    \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0434\u043B\u044F \u0432\u0438\u0440\u0443\u0441\u0430.
    \u0418\u0437 \u044D\u0442\u043E\u0433\u043E \u0443\u0437\u043B\u0430 \u043C\u043E\u0436\u043D\u043E
    \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435
    \u0443\u0437\u043B\u044B \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u041B\u041A\u041C."
  UnvisitedNodeText: "\u042D\u0442\u043E\u0442 \u0443\u0437\u0435\u043B \u0435\u0449\u0435
    \u043D\u0435 \u0431\u044B\u043B \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D
    - \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0438\u043C\u0435\u043D\u043D\u043E
    \u0437\u0434\u0435\u0441\u044C \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0437\u0435\u043B.
    \u0427\u0442\u043E\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u044D\u0442\u043E\u043C
    \u0443\u0437\u043B\u0435, \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043F\u043E
    \u043D\u0435\u043C\u0443 \u041B\u041A\u041C."
