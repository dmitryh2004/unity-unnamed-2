    - rid: 3026835165033791572
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412 \u044D\u0442\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0435
          \u0442\u0432\u043E\u044F \u0446\u0435\u043B\u044C - \u043D\u0430\u0439\u0442\u0438
          \u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439
          \u0443\u0437\u0435\u043B \u0437\u0430\u043C\u043A\u0430 (\u043F\u043E\u043A\u0430\u0437\u0430\u043D
          \u043D\u0438\u0436\u0435)."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        textAlignment: 0
    - rid: 3026835165033791573
      type: {class: ArticlePartImage, ns: , asm: Assembly-CSharp}
