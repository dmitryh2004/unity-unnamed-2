  itemName: "\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A Unnamed-L-21"
  description: "\u041D\u043E\u0432\u0435\u0439\u0448\u0430\u044F \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 Unnamed \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E,
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0442\u044C \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u0432\u0435\u0449\u0435\u0439 \u0432 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u043E\u043C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435, \u0432
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043E\u043D\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F."
  uv1Name: "\u0422\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043E\u0446\u0435\u043D\u043A\u0438
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438"
  uv2Name: 
  uv3Name: 
  additionalInfo: "--- --- ---\n\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    Unnamed-L-21-1\n\n\u041F\u043E \u0437\u0430\u043F\u0440\u043E\u0441\u0430\u043C
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
    \u043E\u0442\u0434\u0435\u043B \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0441\u043E\u0437\u0434\u0430\u043B \u043F\u0435\u0440\u0432\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E
    \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0430\"
    Unnamed-L-1. \u041E\u043D\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0430\u0441\u044C
    \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u0438 \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044E \u0434\u0430\u0432\u0430\u043B\u0430
    \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E \u043E\u0446\u0435\u043D\u043A\u0443
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438. \u0422\u0430\u043A\u0436\u0435
    \u043F\u0435\u0440\u0432\u044B\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
    \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u044B
    \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430,
    \u043B\u0435\u0433\u043A\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u043C\u044B\u0435
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F,
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u043C\u0438
    \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439 [\u0423\u0414\u0410\u041B\u0415\u041D\u041E],
    \u0447\u0442\u043E \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u043B\u043E \u043A
    \u043F\u043E\u0438\u043C\u043A\u0435 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430
    \u0438 \u0443\u0442\u0435\u0447\u043A\u0435 \u043D\u0430\u0448\u0438\u0445 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439.\n\n\u0412
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0431\u0430\u0437\u043E\u0432\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F
    21.1 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043E\u0446\u0435\u043D\u043A\u0443 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438
    \u0432\u0435\u0449\u0435\u0439 \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E
    \u0434\u043E 1 000 000 UMU, \u0430 \u0432\u0435\u0440\u0441\u0438\u044F 21.5
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430 \u0434\u0430\u0432\u0430\u0442\u044C
    \u043E\u0446\u0435\u043D\u043A\u0443 \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E
    \u0434\u043E 1 UMU.\n\n\u0418\u0437 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432
    Unnamed-L-21 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
    \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043F\u043E\u0434\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.
    \u0422\u0430\u043A\u0436\u0435 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
    \u0437\u0430\u0434\u0430\u0442\u044C \u0441\u0432\u043E\u044E \u0444\u043E\u0440\u043C\u0443
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F.
    \u041E\u0442\u0434\u0435\u043B \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0432\u0435\u0434\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0443 \u043D\u0430\u0434
    \u0432\u0435\u0440\u0441\u0438\u0435\u0439 Unnamed-L-25, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0431\u0443\u0434\u0435\u0442 \u043B\u0438\u0448\u0435\u043D\u0430 \u044D\u0442\u0438\u0445
    \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432.\n\n<i>- \u0418\u0437
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u043A
    Unnamed-L-21</i>\n\n--- --- ---\n\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    Unnamed-L-21-2\n\n\u041D\u0435\u0442, \u043C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C
    \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u043C\u0443
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0443 \u0441\u0432\u043E\u0439
    \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\"-21, \u0442\u0430\u043A
    \u043A\u0430\u043A \u0441\u0440\u0435\u0434\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430
    \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442\u0441\u044F
    \u0430\u0433\u0435\u043D\u0442\u044B \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
    [\u0423\u0414\u0410\u041B\u0415\u041D\u041E], \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0431\u0443\u0434\u0443\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0434\u044B
    \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u044D\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u0441\u0432\u043E\u0438\u043C. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0438\"
    \u0431\u0443\u0434\u0443\u0442 \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E
    \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432 \u0432\u0435\u0440\u0441\u0438\u0438 21.1 \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0441\u0440\u043E\u043A\u0430 \u0438 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043A\u0430\u043A \u043C\u0438\u043D\u0438\u043C\u0443\u043C 4 \u0443\u0440\u043E\u0432\u043D\u044F.\n\n\u0412\u0435\u0440\u0441\u0438\u0438
    21.2, 21.3, 21.4 \u0438 21.5 \u0441\u0435\u0440\u0438\u0439\u043D\u043E \u041D\u0415
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0442\u0441\u044F \u0438
    \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u0441\u043E\u0431\u0440\u0430\u043D\u044B
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u0441\u043F\u0435\u0446\u0437\u0430\u043A\u0430\u0437\u0443
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432, \u0432\u043B\u0430\u0434\u0435\u044E\u0449\u0438\u0445
    \u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u043C-21.1.\n\n<i>-
    \u0427\u043B\u0435\u043D \u0421\u043E\u0432\u0435\u0442\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    Unnamed U7-\u2593</i>\n\n--- --- ---\n\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    Unnamed-L-21-3\n\n\u041E\u0442\u0432\u0435\u0447\u0443 \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441,
    \u0442\u0435\u0440\u0437\u0430\u044E\u0449\u0438\u0439 \u043C\u043D\u043E\u0433\u0438\u0445
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432: \u043F\u043E\u0447\u0435\u043C\u0443
    \u043C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
    \u0432\u0441\u0435\u043C \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0438\"
    \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0445 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0445
    \u043C\u043E\u0434\u0435\u043B\u0435\u0439, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    13-\u0439 \u0438\u043B\u0438 17-\u0439?\n\n\u0412\u043E-\u043F\u0435\u0440\u0432\u044B\u0445,
    \u043E\u043D\u0438 \u0443\u0436\u0435 \u043D\u0435\u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u044B:
    \u043F\u043E\u0441\u043B\u0435 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u0430
    [\u0423\u0414\u0410\u041B\u0415\u041D\u041E], \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E [\u0414\u0410\u041D\u041D\u042B\u0415
    \u0423\u0414\u0410\u041B\u0415\u041D\u042B], \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
    \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u0438\u0437\u0434\u0435\u043B\u0438\u0439 Unnamed-L-13, Unnamed-L-17, Unnamed-L-19,
    \u0432\u0441\u0435\u0445 Unnamed-P \u0434\u043E 31 \u0432\u0435\u0440\u0441\u0438\u0438
    \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    Unnamed-L-20, \u0442\u0430\u043A \u043A\u0430\u043A \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u0438
    \u0432 \u0438\u0445 \u0440\u0430\u0431\u043E\u0442\u0435 \u0431\u044B\u043B\u0438
    \u0443\u0447\u0442\u0435\u043D\u044B \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439
    [\u0423\u0414\u0410\u041B\u0415\u041D\u041E], \u0441\u043E\u0437\u0434\u0430\u0432\u0448\u0435\u0439
    \u0438 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0432\u0448\u0435\u0439
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0432\u044B\u0448\u0435\u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u043C
    \u043F\u0440\u0438\u0431\u043E\u0440\u0430\u043C. \n\n\u0422\u0430\u043A\u0436\u0435,
    \u043A \u0441\u043B\u043E\u0432\u0443, \u043C\u044B \u043D\u0435 \u0445\u043E\u0442\u0438\u043C,
    \u0447\u0442\u043E\u0431\u044B \u044D\u0442\u043E\u0442 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442
    \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043B\u0441\u044F \u0441 \u043D\u043E\u0432\u0435\u0439\u0448\u0438\u043C\u0438
    \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u043C\"-21
    \u0438 \"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\u043E\u043C\"-42,
    \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0434\u043B\u044F \u0438\u0445 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0432\u0432\u0435\u0434\u0435\u043D\u044B \u0442\u0430\u043A\u0438\u0435 \u0436\u0435\u0441\u0442\u043A\u0438\u0435
    \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438.\n\n\u0412\u043E-\u0432\u0442\u043E\u0440\u044B\u0445,
    \u0434\u0430\u043D\u043D\u044B\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u0432\"
    \u043C\u0435\u043D\u0435\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B,
    \u0447\u0435\u043C \u0432\u0435\u0440\u0441\u0438\u044F 21. \u0411\u044B\u0432\u0430\u043B\u0438
    \u0441\u043B\u0443\u0447\u0430\u0438, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438
    \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438 \u0438\u0437-\u0437\u0430
    \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u043D\u0430 \u043D\u0438\u0445
    \u0432\u043B\u0430\u0433\u0438, \u043F\u044B\u043B\u0438 \u0438\u043B\u0438 [\u0423\u0414\u0410\u041B\u0415\u041D\u041E].\n\n\u0412-\u0442\u0440\u0435\u0442\u044C\u0438\u0445,
    \u044D\u0442\u0438 \u0432\u0435\u0440\u0441\u0438\u0438 \u043F\u043B\u043E\u0445\u043E
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0441 \u043F\u043E\u0438\u0441\u043A\u043E\u043C
    \u0432\u0435\u0449\u0435\u0439, \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0431\u044B\u043B\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
    500 000 UMU. \u0418\u0437-\u0437\u0430 \u044D\u0442\u043E\u0433\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0438
    \u0438\u043D\u043E\u0433\u0434\u0430 \u043D\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438
    \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u043A\u043D\u0438\u0433\u0438 (\u043A\u043E\u0442\u043E\u0440\u044B\u0435, \u043A\u0430\u043A
    \u0432\u0430\u043C \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E, \u043B\u0435\u0433\u043A\u043E
    \u043C\u043E\u0433\u0443\u0442 \u0441\u0442\u043E\u0438\u0442\u044C \u0438 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u0430 UMU). \u0410\u043D\u0442\u0438\u043C\u0430\u0442\u0435\u0440\u0438\u044F
    \u0442\u043E\u0436\u0435 \u043D\u0435 \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0432\u0430\u043B\u0430\u0441\u044C
    \u044D\u0442\u0438\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u043C
    \u0432 \u2593\u2593% \u0441\u043B\u0443\u0447\u0430\u0435\u0432.\n\n<i>- \u0427\u043B\u0435\u043D
    \u0421\u043E\u0432\u0435\u0442\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
