    - rid: 3026835168771440660
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042D\u0442\u043E\u0442 \u0431\u043E\u043D\u0443\u0441 \u043F\u0440\u0438
          \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
          \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 3 \u0445\u043E\u0434\u043E\u0432
          \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
          \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u043E\u0433\u043E \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
          \u0437\u0430\u0449\u0438\u0442\u044B \u043D\u0430 20 \u0435\u0434., \u0432\u043D\u0435
          \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
          \u0442\u0432\u043E\u0438\u0445 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0445
          \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439. \u042D\u0442\u0438\u043C
          \u0431\u043E\u043D\u0443\u0441\u043E\u043C \u043C\u043E\u0436\u043D\u043E
          \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0430\u043D\u0442\u0438\u0432\u0438\u0440\u0443\u0441\u044B
          \u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0438,
          \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0438\u043C \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
          \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B \u0434\u043B\u044F
          \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
          \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F \u0441\u0432\u043E\u0438\u043C\u0438
          \u0441\u0438\u043B\u0430\u043C\u0438 \u0431\u0435\u0437 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
          \u0443\u0440\u043E\u043D\u0430."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835168771440714
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0432\u0438\u0440\u0443\u0441\u0430"
        fontSize: 18
        bold: 1
        italic: 1
        underline: 1
        color: {r: 0, g: 0.75, b: 0, a: 1}
        textAlignment: 1
    - rid: 3026835168771440715
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0422\u0435\u043A\u0443\u0449\u0435\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435
          \u0442\u0432\u043E\u0435\u0433\u043E \u0432\u0438\u0440\u0443\u0441\u0430
          \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
          \u0432 \u043F\u0440\u0430\u0432\u043E\u043C \u043D\u0438\u0436\u043D\u0435\u043C
          \u0443\u0433\u043B\u0443 \u043E\u043A\u043D\u0430 \u0432\u0437\u043B\u043E\u043C\u0430.
          \u0422\u0430\u043C \u0435\u0441\u0442\u044C \u0434\u0432\u0435 \u0448\u043A\u0430\u043B\u044B:
          \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0430\u044F \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
          \u0442\u0432\u043E\u0439 \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B,
          \u043A\u0440\u0430\u0441\u043D\u0430\u044F - \u0442\u0432\u043E\u044E \u0442\u0435\u043A\u0443\u0449\u0443\u044E
          \u0430\u0442\u0430\u043A\u0443."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835168771440716
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\"
          \u0442\u0430\u043A\u0436\u0435 \u0438\u043C\u0435\u0435\u0442 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438,
          \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0449\u0438\u0435 \u0432 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
          \u0442\u0430\u043A\u0442\u0438\u043A\u0438 \u0432\u0437\u043B\u043E\u043C\u0430:\n-
          \u041A\u043E\u0433\u0434\u0430 \u0442\u044B \u043D\u0430\u0432\u043E\u0434\u0438\u0448\u044C
          \u043C\u044B\u0448\u044C \u043D\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E
          \u0437\u0430\u0449\u0438\u0442\u044B, \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0430\u044F
          \u0448\u043A\u0430\u043B\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
          \u043C\u0435\u0440\u0446\u0430\u0442\u044C, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F,
          \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F
          \u0442\u0432\u043E\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
          \u043F\u0440\u0438 \u0430\u0442\u0430\u043A\u0435;\n- \u0415\u0441\u043B\u0438
          \u0442\u0435\u0431\u0435 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
          \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430 \u0434\u043B\u044F
          \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442\u044C
          \u043E\u0442\u0432\u0435\u0442\u043D\u0443\u044E \u0430\u0442\u0430\u043A\u0443
          \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0437\u0430\u0449\u0438\u0442\u044B,
          \u0442\u0435\u043A\u0441\u0442 \u0441 \u0442\u0435\u043A\u0443\u0449\u0438\u043C
          \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u043E\u043C \u0441\u0442\u0430\u043D\u0435\u0442
          \u043A\u0440\u0430\u0441\u043D\u044B\u043C \u0438 \u0442\u043E\u0436\u0435
          \u0431\u0443\u0434\u0435\u0442 \u043C\u0435\u0440\u0446\u0430\u0442\u044C;\n-
          \u0415\u0441\u043B\u0438 \u0442\u0432\u043E\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
          \u043C\u0435\u043D\u044C\u0448\u0435 20 \u0435\u0434., \u0442\u0435\u043A\u0441\u0442
          \u0441 \u0442\u0435\u043A\u0443\u0449\u0438\u043C \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u043E\u043C
          \u0441\u0442\u0430\u043D\u0435\u0442 \u0436\u0435\u043B\u0442\u044B\u043C
          \u0438 \u0431\u0443\u0434\u0435\u0442 \u043C\u0435\u0440\u0446\u0430\u0442\u044C."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835168771440717
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "<b><u>\u0412\u0430\u0436\u043D\u043E!</u></b> \u041F\u0440\u0438 \u0430\u0442\u0430\u043A\u0435
          \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0437\u0430\u0449\u0438\u0442\u044B
          \u0443\u0434\u0430\u0440 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
          <u>\u0442\u0432\u043E\u0439 \u0432\u0438\u0440\u0443\u0441</u>, \u0438
          \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C, \u0435\u0441\u043B\u0438
          \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u0437\u0430\u0449\u0438\u0442\u044B
          \u043D\u0435 \u0431\u044B\u043B\u043E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043E,
          \u043E\u043D\u043E \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u0439
          \u0443\u0434\u0430\u0440. \u0422\u0430\u043A \u0447\u0442\u043E \u0442\u044B
          \u043C\u043E\u0436\u0435\u0448\u044C \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
          \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u0437\u0430\u0449\u0438\u0442\u044B
          \u0441 \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u043E\u0441\u0442\u044C\u044E
          40, \u0438\u043C\u0435\u044F \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
          \u0432 10 \u0435\u0434., <u>\u0435\u0441\u043B\u0438 \u0442\u044B \u0435\u0433\u043E
          \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0435\u0448\u044C \u0441\u0432\u043E\u0435\u0439
          \u0430\u0442\u0430\u043A\u043E\u0439</u>."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 1, g: 1, b: 0, a: 1}
        textAlignment: 0
