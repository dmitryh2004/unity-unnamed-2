    - rid: 3026835165033791559
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412\u043E-\u043F\u0435\u0440\u0432\u044B\u0445, \u043E\u043D\u043E
          \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
          \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
          \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
          \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u0442\u044B \u0432\u0445\u043E\u0434\u0438\u0448\u044C. \u0422\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
          \u0437\u0430\u043C\u0435\u0447\u0430\u043B \u043E\u043A\u043D\u043E \"\u041A\u0440\u0430\u0442\u043A\u0430\u044F
          \u0441\u0432\u043E\u0434\u043A\u0430\" \u0441\u043B\u0435\u0432\u0430 \u0441\u043D\u0438\u0437\u0443
          \u043F\u0440\u0438 \u0441\u0442\u0430\u0440\u0442\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E
          \u0443\u0440\u043E\u0432\u043D\u044F? \u0422\u0430\u043A \u0432\u043E\u0442,
          \u044D\u0442\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
          \u0443\u043C\u0435\u0435\u0442 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0442\u044C
          \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u0443\u044E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
          \u0432\u0435\u0449\u0435\u0439 \u0432 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0435,
          \u0430 \u0442\u0430\u043A\u0436\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
          \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u043D\u044B\u0445 \u043A\u043E\u043C\u043D\u0430\u0442
          \u0438 \u043A\u043E\u043C\u043D\u0430\u0442-\u0442\u0430\u0439\u043D\u0438\u043A\u043E\u0432.
          \u041E\u0434\u043D\u0430\u043A\u043E \u0435\u0433\u043E \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
          \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0436\u0435\u043B\u0430\u0442\u044C
          \u043B\u0443\u0447\u0448\u0435\u0433\u043E - \u0442\u043E\u043B\u044C\u043A\u043E
          \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0432\u0435\u0440\u0441\u0438\u044F
          (25.5) \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
          \u0442\u043E\u0447\u043D\u0443\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835165033791560
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412\u0442\u043E\u0440\u0430\u044F \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
          \u0432\u0430\u0436\u043D\u0430\u044F \u0444\u0443\u043D\u043A\u0446\u0438\u044F
          - \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C.
          \u041F\u0440\u0438 \u0435\u0433\u043E \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0438
          \u0442\u0432\u043E\u0439 \u0432\u0438\u0437\u043E\u0440 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
          \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0439 \u043E\u0431\u044B\u0447\u043D\u043E\u043C\u0443
          \u0433\u043B\u0430\u0437\u0443 \u0441\u0432\u0435\u0442 \u0432 \u043E\u0442\u0442\u0435\u043D\u043A\u0430\u0445
          \u0441\u0438\u043D\u0435\u0433\u043E. \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
          \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435,
          \u043A\u0430\u043A \u0442\u0435\u0431\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
          \u0441\u043A\u0430\u043D\u0438\u0440\u0443\u044E\u0442 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C
          \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0438\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u043E\u0433\u043E
          \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835165033791561
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u044B\u0439
          \u0440\u0435\u0436\u0438\u043C \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
          \u0442\u0435\u0431\u0435 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
          \u0432\u0435\u0449\u0435\u0439, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0438\u0445\u0441\u044F
          \u0432 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u0445 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u0430
          \u0443\u0440\u043E\u0432\u043D\u044F, \u0442\u0430\u043A\u0438\u0445 \u043A\u0430\u043A
          \u0441\u0435\u0439\u0444\u044B, \u043A\u043D\u0438\u0436\u043D\u044B\u0435
          \u0448\u043A\u0430\u0444\u044B \u0438 \u0441\u0442\u043E\u043B\u044B. \u0412
          \u044D\u0442\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435 \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\"
          \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0440\u0435\u043D\u0442\u0433\u0435\u043D\u043E\u0432\u0441\u043A\u043E\u0433\u043E
          \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
          \u0441\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
          \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u0430,
          \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
          \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u0433\u043E
          \u043B\u0443\u0442\u0430 \u0438 \u0432\u044B\u0432\u043E\u0434\u0438\u0442
          \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043D\u0430
          \u0442\u0432\u043E\u0439 \u0432\u0438\u0437\u043E\u0440, \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0438\u0432\u0430\u044F
          \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440 \u0442\u043E\u0447\u0435\u0447\u043D\u044B\u043C
          \u0443\u0437\u043E\u0440\u043E\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0433\u043E
          \u0446\u0432\u0435\u0442\u0430."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835165033791562
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430
          \u0446\u0432\u0435\u0442\u043E\u0432 \u0442\u043E\u0447\u0435\u0447\u043D\u043E\u0433\u043E
          \u0443\u0437\u043E\u0440\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u043D\u0430
          \u043D\u0438\u0436\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835165033791563
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "<b>\u0412\u0430\u0436\u043D\u043E:</b> \u0432\u0441\u0435 \u044D\u0442\u0438
          \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u0442\u0440\u0435\u0431\u0443\u044E\u0442
          \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
          \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0434\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B,
          \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
          \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\"
          \u0432\u0435\u0447\u043D\u043E \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F.
          \u0425\u043E\u0442\u044C \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\"
          \u0438 \u0433\u0435\u043D\u0435\u0440\u0438\u0440\u0443\u0435\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u044E
          \u0434\u043B\u044F \u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B,
          \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0440\u0430\u0441\u0445\u043E\u0434\u0430
          \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0432\u044B\u0448\u0435, \u0447\u0435\u043C
          \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0435\u0435 \u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u0438."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 3026835165033791565
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "P.S.\n\u0418 \u0434\u0430, \u0441\u043E\u0432\u0441\u0435\u043C \u0437\u0430\u0431\u044B\u043B.
          \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u0438\"
          \u043D\u0435 \u0432\u044B\u0434\u0430\u044E\u0442\u0441\u044F \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439
          \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E - \u043F\u043E\u044D\u0442\u043E\u043C\u0443
          \u0441\u043E\u0432\u0435\u0442\u0443\u044E \u0432 \u043F\u0435\u0440\u0432\u044B\u0439
          \u0436\u0435 \u0432\u044B\u043B\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
          \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0432\u0435\u0449\u0435\u0439,
          \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0438\u0445 \u0438 \u043A\u0443\u043F\u0438\u0442\u044C
          \u0441\u0435\u0431\u0435 \u0445\u043E\u0442\u044F \u0431\u044B \u0432\u0435\u0440\u0441\u0438\u044E
          25.1 \u0434\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 - \u0431\u0435\u0437
          \u044D\u0442\u043E\u0433\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430
          \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442 \u043A\u0440\u0430\u0439\u043D\u0435
          \u0441\u043B\u043E\u0436\u043D\u043E."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
