    RefIds:
    - rid: 3026835165033791566
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\"
          - \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
          \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0438, \u0431\u0435\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
          \u0435\u0435 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
          \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430.
          \u041E\u043D\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
          \u043F\u0440\u043E\u0448\u0438\u0432\u0430\u0442\u044C \u043B\u044E\u0431\u043E\u0435
          \u0434\u0440\u0443\u0433\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E,
          \u0431\u0443\u0434\u044C \u0442\u043E \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\",
          \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B \"\u0420\u044B\u043D\u043A\u0430\"
          \u0438\u043B\u0438 \"\u0410\u0440\u0445\u0438\u0432\u0430\u0442\u043E\u0440\u0430\"
          \u0438\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0435\u0449\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        textAlignment: 0
    - rid: 3026835165033791569
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041E\u0434\u043D\u0430\u043A\u043E 10 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434,
          \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0448\u0430 \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
          \u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u043E\u0440\u044C\u0431\u0443
          \u0441 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439
          [\u0423\u0414\u0410\u041B\u0415\u041D\u041E] (\u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
          \u043D\u0438\u043A\u0442\u043E \u0438\u0437 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0445\u0441\u044F
          \u0432 \u0436\u0438\u0432\u044B\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432,
          \u043A\u0440\u043E\u043C\u0435 \u0421\u043E\u0432\u0435\u0442\u0430 U7,
          \u043D\u0435 \u0437\u043D\u0430\u0435\u0442 \u0435\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
          \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435, \u0442\u0430\u043A \u0436\u0435
          \u043A\u0430\u043A \u0438 \u0442\u043E, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442
          \u043B\u0438 \u043E\u043D\u0430 \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
          \u0434\u0435\u043B\u0435), \u043C\u044B \u043D\u0430\u0448\u043B\u0438
          \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
          \u044D\u0442\u043E\u043C\u0443 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0443.
          \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
          \u043E\u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F
          \u043A \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u043C
          \u0437\u0430\u043C\u043A\u0430\u043C \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
          \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0438\u0445."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        textAlignment: 0
    - rid: 3026835165033791570
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041A\u043E\u0433\u0434\u0430 \u0442\u044B \u043F\u043E\u0434\u043E\u0439\u0434\u0435\u0448\u044C
          \u043A \u0437\u0430\u043C\u043A\u0443 \u0438 \u043F\u043E\u0434\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0448\u044C
          \u0441\u0432\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440,
          \u043D\u0430\u0447\u043D\u0435\u0442\u0441\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441
          \u0432\u0437\u043B\u043E\u043C\u0430. \u041E\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
          \u0441\u043E\u0431\u043E\u0439 \u043C\u0438\u043D\u0438-\u0433\u043E\u043B\u043E\u0432\u043E\u043B\u043E\u043C\u043A\u0443,
          \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043A\u043E\u0442\u043E\u0440\u043E\u0439
          \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438
          \u0437\u0430\u043C\u043A\u0430 (\u043E\u0442 1 \u0434\u043E 10)."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        textAlignment: 0
    - rid: 3026835165033791571
      type: {class: ArticlePartImage, ns: , asm: Assembly-CSharp}
