    - rid: 1539561693458726912
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F
          \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u0430\u043C\u044B\u0445
          \u0440\u0430\u0437\u043D\u044B\u0445 \u043B\u044E\u0434\u0435\u0439. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
          \u0438\u0437 \u043D\u0438\u0445 \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442
          \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u0438\u044F\u043C\u0438
          \u043A \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u043C
          \u0432\u0435\u0449\u0430\u043C (\u043D\u0443 \u0438\u043B\u0438 \u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C
          \u043A \u043D\u0438\u043C) - \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
          \u043E\u0442 \u044D\u0442\u043E\u0433\u043E \u043E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442
          \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430 \u043D\u0438\u0445
          \u043B\u0438\u0431\u043E \u0431\u043E\u043B\u044C\u0448\u0435, \u043B\u0438\u0431\u043E
          \u043C\u0435\u043D\u044C\u0448\u0435. \u0412 \u044D\u0442\u043E\u0439 \u0441\u0442\u0430\u0442\u044C\u0435
          \u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u043E \u0432\u0441\u0435\u0445
          \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0432\u0448\u0438\u0445\u0441\u044F
          \u043C\u043D\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u0445."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726913
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726914
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C
          \u0438\u0437 \u0441\u0435\u0440\u043E\u0439 \u043C\u0430\u0441\u0441\u044B.
          \u041F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0439
          \u043D\u0435\u0442, \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442 \u0432\u0441\u0435
          \u043F\u043E \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u0439
          \u0446\u0435\u043D\u0435. \u0414\u0430\u0436\u0435 \u043F\u0438\u0441\u0430\u0442\u044C
          \u043F\u0440\u043E \u043D\u0435\u0433\u043E \u0441\u043A\u0443\u0447\u043D\u043E..."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726915
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042E\u0432\u0435\u043B\u0438\u0440"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726916
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042D\u0442\u043E\u0442 \u0442\u0438\u043F \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432
          \u0441\u043A\u0443\u043F\u0430\u0435\u0442 \u043D\u0435\u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435
          \u0438 \u0431\u0440\u0430\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0435
          \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u044B\u0435 \u043A\u0430\u043C\u043D\u0438,
          \u0430 \u0442\u0430\u043A\u0436\u0435 \u0438\u0445 \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438
          \u043F\u043E \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u043E\u0439
          \u0446\u0435\u043D\u0435. \u0417\u0430 \u0434\u043E\u0441\u0440\u043E\u0447\u043D\u043E\u0435
          \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0435\u0433\u043E
          \u0437\u0430\u043A\u0430\u0437\u0430 \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C
          \u043D\u0430 \u0441\u0432\u043E\u0439 \u0431\u0430\u043B\u0430\u043D\u0441
          25% \u043E\u0442 \u0435\u0433\u043E \u0441\u0443\u043C\u043C\u044B (\u0435\u0441\u043B\u0438
          \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u043D\u0430 \u0434\u0435\u043D\u044C
          \u0440\u0430\u043D\u044C\u0448\u0435) \u0438\u043B\u0438 50% (\u0435\u0441\u043B\u0438
          \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F \u0440\u0430\u043D\u044C\u0448\u0435). "
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726917
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0415\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u043F\u0440\u043E\u043A\u0430\u0447\u0430\u043D
          \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0439 \u0441\u0442\u043E\u043B,
          \u0442\u043E \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0435\u0433\u043E
          \u0437\u0430\u0434\u0430\u043D\u0438\u0435 - \u043D\u0435 \u0441\u0430\u043C\u044B\u0439
          \u043B\u0443\u0447\u0448\u0438\u0439 \u0432\u044B\u0431\u043E\u0440, \u0442\u0430\u043A
          \u043A\u0430\u043A \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u0442\u044C
          \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u0432\u043E \u0447\u0442\u043E-\u0442\u043E
          \u0431\u043E\u043B\u0435\u0435 \u0446\u0435\u043D\u043D\u043E\u0435. \u041D\u043E
          \u0432\u0441\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442
          \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432:
          \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
          \u043E\u043D \u0442\u0435\u0431\u044F \u0441\u043F\u0430\u0441\u0435\u0442
          \u043E\u0442 \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u044F."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726918
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041C\u0430\u0440\u043E\u0434\u0435\u0440"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726919
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          \u044E\u0432\u0435\u043B\u0438\u0440\u0430: \u0435\u0441\u043B\u0438 \u0442\u043E\u0442
          \u0431\u0435\u0440\u0435\u0442 \u043D\u0435\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
          \u043A\u0430\u043C\u043D\u0438, \u0442\u043E \u043C\u0430\u0440\u043E\u0434\u0435\u0440
          \u043F\u043B\u0430\u0442\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
          \u0437\u0430 \u0438\u0445 \u0434\u043E\u0440\u043E\u0433\u0438\u0435 \u0432\u0435\u0440\u0441\u0438\u0438.
          \u0422\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0438 \u044E\u0432\u0435\u043B\u0438\u0440,
          \u043F\u043B\u0430\u0442\u0438\u0442 \u0437\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
          \u0437\u0430\u043A\u0430\u0437\u0430 \u0440\u0430\u043D\u044C\u0448\u0435
          \u0441\u0440\u043E\u043A\u0430, \u0438 \u0432 \u0442\u0430\u043A\u043E\u043C
          \u0436\u0435 \u043E\u0431\u044A\u0435\u043C\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726920
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440,
          \u0435\u0441\u043B\u0438 \u0443 \u0442\u0435\u0431\u044F \u043F\u0440\u043E\u043A\u0430\u0447\u0430\u043D
          \u044E\u0432\u0435\u043B\u0438\u0440\u043D\u044B\u0439 \u0441\u0442\u043E\u043B
          \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043D\u043E\u0433\u043E
          \u0434\u043E\u0440\u043E\u0433\u0438\u0445 \u043A\u0430\u043C\u043D\u0435\u0439
          \u0432 \u0437\u0430\u043F\u0430\u0441\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726921
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\u0440\u044C"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726922
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042D\u0442\u043E\u0442 \u0442\u0438\u043F \u0430\u043A\u0442\u0438\u0432\u043D\u043E
          \u0438\u0449\u0435\u0442 \u043A\u043D\u0438\u0433\u0438 \u0432 \u0441\u0432\u043E\u044E
          \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443. \u0417\u0430
          \u0440\u0435\u0434\u043A\u0438\u0435 \u0438 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u044B\u0435
          \u0438\u0437\u0434\u0430\u043D\u0438\u044F \u043A\u043D\u0438\u0433 \u043E\u043D
          \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435,
          \u0430 \u0437\u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u043A\u043D\u0438\u0433\u0438
          - \u043C\u0435\u043D\u044C\u0448\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726923
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0448\u044C
          \u0435\u0433\u043E \u0437\u0430\u043A\u0430\u0437, \u0438\u0449\u0438 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440\u044B
          \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u0442\u043E\u043C\u0430 \"\u041C\u0435\u0440\u0442\u0432\u044B\u0445
          \u0434\u0443\u0448\" - \u0446\u0435\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
          \u043E\u043D \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
          \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u0430\u043A\u043E\u0439
          \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440, \u0442\u0435\u0431\u044F
          \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0443\u0434\u0438\u0432\u0438\u0442."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726924
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0424\u0438\u043B\u043E\u0441\u043E\u0444"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726925
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
          \u043F\u0438\u0442\u0430\u0435\u0442 \u043D\u0435\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043C\u043E
          \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441
          \u043A \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u0420\u0438\u0447\u0430\u0440\u0434\u0430
          \u0422\u0440\u0435\u0442\u044C\u0435\u0433\u043E. \u041D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
          \u0441\u0438\u043B\u044C\u043D\u044B\u0439, \u0447\u0442\u043E \u0437\u0430
          \u043A\u0430\u0436\u0434\u044B\u0439 \u0435\u0435 \u044D\u043A\u0437\u0435\u043C\u043F\u043B\u044F\u0440
          \u043E\u043D \u0433\u043E\u0442\u043E\u0432 \u043E\u0442\u0441\u0442\u0435\u0433\u043D\u0443\u0442\u044C
          \u043F\u043E \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u0443. \u042F \u043D\u0435
          \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0434\u0432\u0438\u0436\u0435\u0442
          \u044D\u0442\u0438\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
          \u043D\u043E \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u044D\u0442\u043E
          \u0441\u0430\u043C\u044B\u0439 \u043B\u0443\u0447\u0448\u0438\u0439 \u043A\u043B\u0438\u0435\u043D\u0442
          - \u043A \u0442\u043E\u043C\u0443 \u0436\u0435, \u043D\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435
          \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u043E\u043D \u0434\u0430\u0435\u0442
          4 \u0434\u043D\u044F, \u0430 \u043D\u0435 3, \u0447\u0442\u043E \u0434\u0430\u0435\u0442
          \u0442\u0435\u0431\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          \u043F\u043E\u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0435\u0449\u0435
          \u0432\u0435\u0449\u0435\u0439."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726926
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0435\u0440"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726927
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
          \u0438\u0449\u0435\u0442 \u043D\u0430 \u043D\u0430\u0448\u0435\u043C \u0440\u044B\u043D\u043A\u0435
          \u0432\u0441\u044F\u043A\u0438\u0435 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u0438,
          \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u0441\u0442\u0430\u0440\u044B\u0435
          \u043C\u043E\u043D\u0435\u0442\u044B. \u0415\u043C\u0443 \u0442\u0430\u043A\u0436\u0435
          \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C
          \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u044B\u0435
          \u0438\u0437\u0434\u0430\u043D\u0438\u044F \u043A\u043D\u0438\u0433 \u0438
          \u0440\u0435\u0434\u043A\u0438\u0435 \u0438\u0437\u0434\u0430\u043D\u0438\u044F
          \"\u041C\u0435\u043C\u043E\u043B\u043E\u0433\u0438\u0438\". \u041D\u0430
          \u0441\u0431\u043E\u0440 \u0432\u0435\u0449\u0435\u0439 \u0434\u0430\u0435\u0442
          4 \u0434\u043D\u044F, \u0442\u0430\u043A \u043A\u0430\u043A \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442,
          \u0447\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
          \u0440\u0435\u0434\u043A\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
          \u0441\u043B\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438. \u041F\u043E
          \u044D\u0442\u043E\u0439 \u0436\u0435 \u043F\u0440\u0438\u0447\u0438\u043D\u0435
          \u0434\u0430\u0435\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435
          \u0431\u043E\u043D\u0443\u0441\u044B \u0432 \u043A\u0430\u0440\u043C\u0430\u043D
          \u043F\u0440\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438
          \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0440\u043E\u043A\u0430 (10%
          \u0437\u0430 \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u0438 25%
          \u0437\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F)."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726928
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726929
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0414\u0430-\u0434\u0430, \u043D\u0435 \u0443\u0434\u0438\u0432\u043B\u044F\u0439\u0441\u044F
          - \u0438 \u043E\u043D\u0438 \u0442\u043E\u0436\u0435 \u0438\u043D\u043E\u0433\u0434\u0430
          \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043A \u043D\u0430\u043C.
          \u041E\u043D\u0438 \u0438\u0449\u0443\u0442 \u0443 \u043D\u0430\u0441 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
          \u043A\u043D\u0438\u0433\u0438 \u0438 \u043F\u043B\u044F\u0442\u044F\u0442
          \u0437\u0430 \u043D\u0438\u0445 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
          \u0438\u0445 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 1539561693458726930
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0420\u0435\u0439\u0442\u0438\u043D\u0433 \u0442\u0438\u043F\u043E\u0432
          \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.7529412, b: 0, a: 1}
        textAlignment: 1
    - rid: 1539561693458726931
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041B\u0438\u0447\u043D\u043E \u044F \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u043B
          \u0443 \u0441\u0435\u0431\u044F \u0432 \u0433\u043E\u043B\u043E\u0432\u0435
          \u0442\u0430\u043A\u043E\u0439 \u0440\u0435\u0439\u0442\u0438\u043D\u0433
          \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439:\n1.
          \u0424\u0438\u043B\u043E\u0441\u043E\u0444\n2. \u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u0435\u0440\n3.
          \u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\u0440\u044C\n4.
          \u041C\u0430\u0440\u043E\u0434\u0435\u0440\n5. \u042E\u0432\u0435\u043B\u0438\u0440\n6.
          \u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C\n\u0423\u0447\u0438\u0442\u0435\u043B\u0435\u0439
          \u044F \u0437\u0430 \u0441\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443
          \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B,
          \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u044C
          \u0441 \u043A\u0435\u043C-\u043B\u0438\u0431\u043E \u0438\u0445 \u044F
          \u043D\u0435 \u043C\u043E\u0433\u0443.\n\u041E\u0431\u0440\u0430\u0449\u0443
          \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u0447\u0442\u043E \u044D\u0442\u043E
          \u043D\u0435 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E
          \u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E, \u0432\u044B\u0431\u043E\u0440
          \u0442\u043E\u0433\u043E \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
          \u0437\u0430\u0434\u0430\u043D\u0438\u044F \u0437\u0430\u0432\u0438\u0441\u0438\u0442
          \u043E\u0442 \u0442\u0432\u043E\u0438\u0445 \u0442\u0435\u043A\u0443\u0449\u0438\u0445
          \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
