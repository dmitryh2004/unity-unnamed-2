    \u0442\u043E\u043F\u0430\u0437\u0430, \u0438\u043C\u0435\u044E\u0449\u0430\u044F
    \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0446\u0435\u043D\u0443 \u043D\u0430
    \u0440\u044B\u043D\u043A\u0435. \u0410 \u0443\u0436 \u043C\u0430\u0440\u043E\u0434\u0435\u0440\u044B
