  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F
    \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0432\u0430\u0448\u0435
    \u0437\u0430\u0434\u0430\u043D\u0438\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F Unnamed \u0440\u0435\u0448\u0438\u043B\u0430
    \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u043E\u0442 \u0432\u0430\u0441
    \u0438\u0437-\u0437\u0430 \u043F\u043E\u043D\u0435\u0441\u0435\u043D\u043D\u044B\u0445
    \u0435\u044E \u0443\u0431\u044B\u0442\u043A\u043E\u0432 \u0432 \u0441\u0432\u044F\u0437\u0438
    \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439 \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0438
    \u0432\u0435\u0449\u0435\u0439.\n\n\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0435 \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    \u0443\u0432\u043E\u043B\u044C\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0441\u044F
    \u043F\u0443\u0442\u0435\u043C \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044F
    \u0443\u0432\u043E\u043B\u044C\u043D\u044F\u0435\u043C\u043E\u0433\u043E \u0441
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u044B
    \u0434\u043B\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0441\u0442\u0438 \u0435\u0435
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439. \u0414\u0430\u043D\u043D\u044B\u0439
    \u0444\u0430\u043A\u0442 \u0431\u044B\u043B \u043E\u0442\u0440\u0430\u0436\u0435\u043D
    \u0432 \u0442\u0440\u0443\u0434\u043E\u0432\u043E\u043C \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0435,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0412\u044B \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
    \u0441 \u044D\u0442\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u043E\u0439
    \u043F\u0440\u0438 \u0435\u0433\u043E \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u0438.\n\n\u042D\u0442\u043E
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0441\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437
    15 \u0441\u0435\u043A\u0443\u043D\u0434."
