    - rid: 6553496767108218969
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0439
          \u043D\u0430\u0448\u0438\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
          \u0437\u0430 \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430\u043C\u0438\"
          \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439 \u0431\u044B\u043B
          \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u044B\u0439
          \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u0438\u0445 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F,
          \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u044F \u0437\u0434\u0435\u0441\u044C
          \u043D\u0430\u043F\u0438\u0448\u0443."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
