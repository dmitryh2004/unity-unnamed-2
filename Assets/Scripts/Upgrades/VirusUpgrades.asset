  itemName: "\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440
    Unnamed-P-42"
  description: "\u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u044B\u0439
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    Unnamed, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438
    \u0434\u043B\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0441\u0430\u043C\u044B\u0445 \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445
    \u0437\u0430\u0434\u0430\u0447. \u0421\u0440\u0435\u0434\u0438 \u043F\u0440\u043E\u0447\u0435\u0433\u043E,
    \u043E\u043D \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F
    \u0434\u043B\u044F \u0434\u0435\u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
    \u0437\u0430\u043C\u043A\u043E\u0432 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
    [\u0423\u0414\u0410\u041B\u0415\u041D\u041E]."
  uv1Name: "\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
    \u0432\u0438\u0440\u0443\u0441\u0430"
  uv2Name: "\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u044F \u0432\u0440\u0435\u0434\u043E\u043D\u043E\u0441\u043D\u043E\u0441\u0442\u044C
    \u0432\u0438\u0440\u0443\u0441\u0430"
  uv3Name: 
  uv4Name: 
  uv5Name: 
  uv6Name: 
  additionalInfo: "--- --- ---\n\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    Unnamed-P-42-1\n\n\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440
    Unnamed-P-42 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0439
    \u0432\u0435\u0440\u0441\u0438\u0438, Unnamed-P-37 - \u0432 \u043D\u0435\u043C
    \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430
    \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u0432 \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    L-10 \u0437\u0430\u043C\u043A\u043E\u0432 \u043D\u043E\u0432\u0435\u0439\u0448\u0435\u0439
    \u043C\u043E\u0434\u0435\u043B\u0438, [\u0423\u0414\u0410\u041B\u0415\u041D\u041E]-1024
    (\u0434\u043B\u044F \u043A\u0440\u0430\u0442\u043A\u043E\u0441\u0442\u0438 \u0434\u0430\u043B\u0435\u0435
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438
    \u043E\u043F\u0443\u0441\u0442\u0438\u043C, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u043E\u043C\u0435\u0440), \u0447\u0442\u043E
    \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u043D\u0430\u043C \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043D\u0430\u0448\u0438\u0445 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432.
    \u0412 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
    \u043C\u044B \u0438\u0434\u0435\u043C \u043D\u0430 \u043E\u043F\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0435
    \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0438 [\u0423\u0414\u0410\u041B\u0415\u041D\u041E],
    \u0442\u0430\u043A \u043A\u0430\u043A \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
    \u0437\u0430\u043C\u043A\u043E\u0432, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
    \u043C\u044B \u0441\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u043B\u0438\u0441\u044C,
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B \u043C\u043E\u0434\u0435\u043B\u044F\u043C\u0438
    32, 64, 128 \u0438 256, \u0430 \u043C\u043E\u0434\u0435\u043B\u0438 512 \u0438
    1024 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F \u0440\u0435\u0434\u043A\u043E
    (\u043F\u043E \u0434\u0430\u043D\u043D\u044B\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432
    \u0437\u0430 \u2593\u2593\u2593\u2593 \u0433\u043E\u0434).\n\n<i>- \u0418\u0437
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438 \u043A
    \u0438\u0437\u0434\u0435\u043B\u0438\u044E Unnamed-P-42</i>\n\n--- --- ---\n\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    Unnamed-P-42-2\n\n\u0412 \u0441\u0432\u044F\u0437\u0438 \u0441 \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442\u043E\u043C
    [\u0423\u0414\u0410\u041B\u0415\u041D\u041E], \u043F\u043E\u0432\u043B\u0435\u043A\u0448\u0438\u043C
    \u043F\u0440\u0435\u0436\u0434\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439
    \u0432\u044B\u0432\u043E\u0434 \u0438\u0437 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438
    \u0432\u0441\u0435\u0445 \"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\u043E\u0432\"
    \u0434\u043E 31 \u0432\u0435\u0440\u0441\u0438\u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u0432\"-13,
    -17, -19 \u0438 -20, \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u0443\u0442\u0435\u0447\u043A\u0438 \u0434\u0430\u043D\u043D\u044B\u0445 \u043E\u0431
    \u044D\u0442\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435:\n-
    \"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\"-42
    \u043B\u044E\u0431\u043E\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C
    \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043D\u0435 \u043D\u0438\u0436\u0435 4;\n- \u0414\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\u0430\"
    \u0432\u0435\u0440\u0441\u0438\u0438 42.4, 42.5 \u0438\u043B\u0438 42.6 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043D\u0435 \u043D\u0438\u0436\u0435 5;\n- \"\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\"-42.7
    \u0432\u044B\u0434\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044E \u0421\u043E\u0432\u0435\u0442\u0430
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 Unnamed \u043F\u0440\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0438
    \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 50% \u0447\u043B\u0435\u043D\u043E\u0432
    U7 \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C
    \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u043B\u043E\u044F\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    6 \u0438\u043B\u0438 \u0432\u044B\u0448\u0435.\n\n<i>\u0427\u043B\u0435\u043D
    \u0421\u043E\u0432\u0435\u0442\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
    Unnamed U7-\u2593</i>\n\n--- --- ---\n\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    Unnamed-P-42-3\n\n\u041F\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
    \u0434\u0430\u043D\u043D\u044B\u043C, \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F
    [\u0423\u0414\u0410\u041B\u0415\u041D\u041E] \u043F\u043E\u0439\u043C\u0430\u043B\u0430
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043D\u0430\u0448\u0438\u0445
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u0438 \u0438\u0437\u044A\u044F\u043B\u0430
    \u0443 \u043D\u0438\u0445 Unnamed-P-42, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
    \u0441\u0430\u043C\u0443\u044E \u043C\u043E\u0449\u043D\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E
    (42.7). \u041F\u043E \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
    \u043F\u0440\u0438\u0447\u0438\u043D\u0430\u043C \u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u0441\u0430\u043C\u043E\u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432 \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430,
    \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0431 \u044D\u0442\u043E\u0439
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0437\u043D\u0430\u0435\u0442
    \u043D\u0430\u0443\u0447\u043D\u043E-\u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0439
    \u043E\u0442\u0434\u0435\u043B [\u0423\u0414\u0410\u041B\u0415\u041D\u041E].
    \u041E\u043D\u0438 \u0432\u0435\u0434\u0443\u0442 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0443
    \u0437\u0430\u043C\u043A\u0430 \u043C\u043E\u0434\u0435\u043B\u0438 2048, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u0432\u043D\u0435\u0434\u0440\u044F\u044E\u0442
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430
    \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u044F L-11 \u0432 \u0437\u0430\u043C\u043A\u0438
    \u0432\u0441\u0435\u0445 \u043C\u043E\u0434\u0435\u043B\u0435\u0439.\n\n\u0417\u0430\u043C\u043E\u043A
    \u0441 \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u043C
    L-11 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0432\u0437\u043B\u043E\u043C\u0430\u043D
    \u043D\u0438 \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043D\u0430\u0448\u0438\u0445
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\u0442\u043E\u0440\u043E\u0432,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432 \u0442\u0435\u043A\u0443\u0449\u0438\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442 \u0441\u0438\u043B\u044B \u043E\u0442\u0434\u0435\u043B\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438 Unnamed \u0431\u0440\u043E\u0448\u0435\u043D\u044B
