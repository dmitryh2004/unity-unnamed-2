  lootName: "\"\u041C\u0435\u0440\u0442\u0432\u044B\u0435 \u0434\u0443\u0448\u0438.
    \u0422\u043E\u043C 2\""
  lootDesc: "\u041C\u0435\u043B\u044C\u043A\u043E\u043C \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0432\u0448\u0438\u0441\u044C
    \u0441 \u0442\u0435\u043A\u0441\u0442\u043E\u043C \u0434\u0430\u043D\u043D\u043E\u0439
    \u043A\u043D\u0438\u0433\u0438, \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435,
    \u0447\u0442\u043E \u044D\u0442\u043E - \u0432\u0442\u043E\u0440\u043E\u0439
    \u0442\u043E\u043C \"\u041C\u0435\u0440\u0442\u0432\u044B\u0445 \u0434\u0443\u0448\",
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0431\u044B\u043B \u0441\u043E\u0436\u0436\u0435\u043D
    \u0441\u0432\u043E\u0438\u043C \u0430\u0432\u0442\u043E\u0440\u043E\u043C. \u0412\u0435\u0441\u044C\u043C\u0430
    \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u0447\u0442\u043E \u044D\u0442\u043E
    \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0430
    (\u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u044D\u0442\u043E,
    \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0441\u0442\u0438\u043B\u044C \u0430\u0432\u0442\u043E\u0440\u0430 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043D
    \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0442\u043E\u0447\u043D\u043E).
    \u0412 \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u043E\u043C
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u044D\u0442\u0430 \u043A\u043D\u0438\u0433\u0430
    \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u0441\u0442\u0430\u043D\u0435\u0442
    \u0442\u0435\u043C\u043E\u0439 \u0434\u043B\u044F \u0434\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u0439."
