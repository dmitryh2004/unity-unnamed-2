    - rid: 3026835168771440657
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u042D\u0442\u043E\u0442 \u0431\u043E\u043D\u0443\u0441 \u043F\u0440\u0438
          \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0438
          \u0434\u0430\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442
          2 \u0430\u0442\u0430\u043A \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0437\u0430\u0449\u0438\u0442\u044B.
          \u041E\u0434\u043D\u0430\u043A\u043E \u043F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439
          \u044D\u0444\u0444\u0435\u043A\u0442 \u0430\u043D\u0442\u0438\u0432\u0438\u0440\u0443\u0441\u0430
          \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
          \u0434\u0430\u0436\u0435 \u043F\u0440\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u043C
          \u0431\u043E\u043D\u0443\u0441\u0435, \u0442\u0430\u043A \u0447\u0442\u043E
          \u0431\u0443\u0434\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u0435\u043D.
          \u042D\u0442\u043E\u0442 \u0431\u043E\u043D\u0443\u0441 \u043C\u043E\u0436\u043D\u043E
          \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
          \u0434\u043B\u044F \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u044F
          \u0430\u043D\u0442\u0438\u0432\u0438\u0440\u0443\u0441\u043E\u0432 \u0438
          \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u0432
          \u0431\u0435\u0437 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
          \u0443\u0440\u043E\u043D\u0430."
        fontSize: 18
        bold: 0
        italic: 0
