    - rid: 5720227232747880517
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "upd. \u0423\u0432\u044B, \u043A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
          \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F [\u0423\u0414\u0410\u041B\u0415\u041D\u041E]
          \u0440\u0435\u0430\u043B\u044C\u043D\u043E \u0443\u043B\u0443\u0447\u0448\u0438\u043B\u0430
          \u0418\u0418 \u0441\u0432\u043E\u0438\u0445 \u0440\u043E\u0431\u043E\u0442\u043E\u0432
          \u0438 \u0443\u0436\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0430
          \u043D\u043E\u0432\u0443\u044E \u0432\u0435\u0440\u0441\u0438\u044E \u043D\u0430
          \u0432\u0441\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u044B\u0435
          \u043E\u0431\u044A\u0435\u043A\u0442\u044B. \u041F\u043E\u0447\u0438\u0442\u0430\u0442\u044C
          \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435 \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C
          \u043F\u043E \u0441\u0441\u044B\u043B\u043A\u0435 \u043D\u0438\u0436\u0435."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 1, b: 1, a: 1}
        textAlignment: 0
    - rid: 5720227232747880518
      type: {class: ArticlePartLink, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0432 \u0418\u0418
          \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
        article: {fileID: 11400000, guid: c0f81819e688b194aa028da04fbb84e0, type: 2}
    - rid: 6553496767108218958
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412\u0441\u0435 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u044B,
          \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
          \u0432\u044B\u043B\u0435\u0442\u0435\u0442\u044C, \u0442\u0430\u043A \u0438\u043B\u0438
          \u0438\u043D\u0430\u0447\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
          \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439 [\u0423\u0414\u0410\u041B\u0415\u041D\u041E].
          \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432 \u043D\u0438\u0445 \u043D\u0443\u0436\u043D\u043E
          \u0431\u044B\u0442\u044C \u043A\u0440\u0430\u0439\u043D\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u043C,
          \u0432\u0435\u0434\u044C \u0446\u0435\u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0438
          \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0432\u044B\u0441\u043E\u043A\u0430."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218959
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0444\u0430\u043A\u0442\u043E\u0440\u044B
          \u0437\u0430\u0449\u0438\u0442\u044B \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043E\u0432
          \u0438 \u0432\u0435\u0449\u0435\u0439 \u0432 \u043D\u0438\u0445 - \u044D\u0442\u043E:\n-
          \u0411\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
          \u0437\u0430\u043C\u043A\u043E\u0432 \u0440\u0430\u0437\u043D\u043E\u0439
          \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u0438;\n- \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438,
          \u043F\u0430\u0442\u0440\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0435
          \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441;\n- \u0421\u0438\u0441\u0442\u0435\u043C\u0430
          \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218960
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0417\u0430\u043C\u043A\u0438"
        fontSize: 18
        bold: 0
        italic: 0
        underline: 1
        color: {r: 0, g: 0.75, b: 0, a: 1}
        textAlignment: 1
    - rid: 6553496767108218961
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0417\u0430\u043C\u043A\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
          \u0441\u043E\u0431\u043E\u0439 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0435
          \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430, \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0449\u0438\u0435
          \u0434\u0432\u0435\u0440\u044C \u0438\u043B\u0438 \u0441\u0435\u0439\u0444
          \u0438 \u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0435 \u0434\u043B\u044F
          \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432
          \u0438\u043B\u0438 \u0443\u0441\u043B\u043E\u0436\u043D\u0435\u043D\u0438\u044F
          \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u043A \u043D\u0438\u043C. \u041F\u0440\u0438
          \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u043C \u0437\u0430\u043C\u043A\u0435
          \u0434\u0432\u0435\u0440\u044C \u0438\u043B\u0438 \u0441\u0435\u0439\u0444
          \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218962
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0437\u0430\u043C\u043E\u043A
          \u0438\u043C\u0435\u0435\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
          \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0439 \u0434\u0438\u0441\u043F\u043B\u0435\u0439,
          \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u0430
          \u0442\u0435\u043A\u0443\u0449\u0430\u044F \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          \u0437\u0430\u043C\u043A\u0430. \u041E\u043D\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
          \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u043C\u0438\u043D\u0438-\u0438\u0433\u0440\u044B,
          \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0441\u044F
          \u043F\u0440\u0438 \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u0432\u0437\u043B\u043E\u043C\u0430.
          \n\u041F\u0440\u0438 \u0443\u0434\u0430\u0447\u043D\u043E\u043C \u0432\u0437\u043B\u043E\u043C\u0435
          \u0437\u0430\u043C\u043E\u043A \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0441\u044F,
          \u043E\u0442\u043A\u0440\u044B\u0432 \u0434\u043E\u0441\u0442\u0443\u043F
          \u043A \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u043C\u043E\u043C\u0443
          \u043E\u0431\u044A\u0435\u043A\u0442\u0443. \u041F\u0440\u0438 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u043E\u043C
          \u0432\u0437\u043B\u043E\u043C\u0435 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          \u0437\u0430\u043C\u043A\u0430 \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u0441\u044F
          \u043D\u0430 1. \u0415\u0441\u043B\u0438 \u0437\u0430\u043C\u043E\u043A
          \u0443\u0436\u0435 \u0438\u043C\u0435\u043B \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          10, \u0442\u043E \u0437\u0430\u043C\u043E\u043A \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442\u0441\u044F
          \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
          \u0430 \u0446\u0432\u0435\u0442 \u0434\u0438\u0441\u043F\u043B\u0435\u044F
          \u0441\u0442\u0430\u043D\u0435\u0442 \u043A\u0440\u0430\u0441\u043D\u044B\u043C.
          \u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
          \u0437\u0430\u043C\u043A\u0438 \u043C\u044B \u043F\u043E\u043A\u0430 \u0447\u0442\u043E
          \u0432\u0437\u043B\u0430\u043C\u044B\u0432\u0430\u0442\u044C \u043D\u0435
          \u0443\u043C\u0435\u0435\u043C."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218963
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0412\u0441\u0435 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u044B
          \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442\u0441\u044F \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u0435\u0439
          [\u0423\u0414\u0410\u041B\u0415\u041D\u041E] \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E,
          \u0438 \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0433\u043E
          \u0442\u0438\u043F\u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
          \u0437\u0430\u043C\u043A\u0438 \u0441\u043E \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E
          \u0438\u0437 \u043E\u0434\u043D\u043E\u0433\u043E \u0438 \u0442\u043E\u0433\u043E
          \u0436\u0435 \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u0430. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
          \u043F\u043E \u0437\u0430\u043C\u043A\u0443 \u0438\u043D\u043E\u0433\u0434\u0430
          \u043C\u043E\u0436\u043D\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C,
          \u0447\u0442\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
          \u0437\u0430 \u0434\u0432\u0435\u0440\u044C\u044E."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218964
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u0421\u0442\u043E\u0438\u0442 \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C,
          \u0447\u0442\u043E \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          \u0437\u0430\u043C\u043A\u0430 \u043D\u0438\u043A\u0430\u043A \u043D\u0435
          \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438
          \u0432\u0435\u0449\u0435\u0439, \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u043C\u044B\u0445
          \u044D\u0442\u0438\u043C \u0437\u0430\u043C\u043A\u043E\u043C. \u0412\u0441\u0435\u0433\u0434\u0430
          \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
          \u043B\u0443\u0442\u0430 \u0441\u0432\u043E\u0438\u043C \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0449\u0438\u043A\u043E\u043C\"
          \u043F\u0435\u0440\u0435\u0434 \u0432\u0437\u043B\u043E\u043C\u043E\u043C:
          \u0431\u0443\u0434\u0435\u0442 \u043E\u0431\u0438\u0434\u043D\u043E, \u0435\u0441\u043B\u0438
          \u043F\u043E\u0441\u043B\u0435 \u0432\u0437\u043B\u043E\u043C\u0430 \u0441\u043B\u043E\u0436\u043D\u043E\u0433\u043E
          \u0437\u0430\u043C\u043A\u0430 \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u0439
          \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u0443\u0441\u0442\u043E\u0439
          \u0441\u0435\u0439\u0444."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 1, g: 1, b: 0, a: 1}
        textAlignment: 0
    - rid: 6553496767108218965
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u043C\u043A\u0438
          \u0438\u043C\u0435\u044E\u0442 \u0437\u043D\u0430\u0447\u043E\u043A \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0430
          \u0432 \u043F\u0440\u0430\u0432\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
          \u0434\u0438\u0441\u043F\u043B\u0435\u044F - \u044D\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442,
          \u0447\u0442\u043E \u0437\u0430\u043C\u043E\u043A \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D
          \u043A \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438.
          \u0415\u0441\u043B\u0438 \u0441\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C
          \u0437\u0430\u043C\u043A\u0430 \u043F\u0440\u0435\u0432\u044B\u0441\u0438\u0442
          \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E \u043F\u043E\u0434
          \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u043E\u043C, \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
          \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044F,
          \u0438 \u0432\u0441\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
          \u0441\u0431\u0435\u0433\u0443\u0442\u0441\u044F \u043A \u044D\u0442\u043E\u043C\u0443
          \u0437\u0430\u043C\u043A\u0443."
