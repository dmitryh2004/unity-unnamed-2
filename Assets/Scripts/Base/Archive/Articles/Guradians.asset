    - rid: 6553496767108218973
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\" \u043D\u0430
          \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
          \u0431\u0435\u0436\u0438\u0442 \u0437\u0430 \u0438\u0433\u0440\u043E\u043A\u043E\u043C
          \u0438\u043B\u0438 \u043A \u043C\u0435\u0441\u0442\u0443 \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u043D\u0438\u044F
          \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
          (\u0435\u0441\u043B\u0438 \u0442\u0430\u043A\u043E\u0432\u043E\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E).
          \u0412 \u044D\u0442\u043E\u0439 \u0444\u0430\u0437\u0435 \u0440\u043E\u0431\u043E\u0442\u0430
          \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
          \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0432\u0430\u0441 \u0438\u0437
          \u0432\u0438\u0434\u0443 - \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
          \u043E\u0431\u044B\u0447\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
          \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0437\u0430 \u0443\u0433\u043E\u043B.\n\u041F\u043E\u0441\u043B\u0435
          \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\"
          \u0434\u043E\u0431\u0435\u0436\u0430\u043B \u0434\u043E \u0441\u0432\u043E\u0435\u0439
          \u0442\u043E\u0447\u043A\u0438 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F,
          \u043E\u043D \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u0432
          \u0444\u0430\u0437\u0443 3."
        fontSize: 18
        bold: 0
        italic: 0
        underline: 0
        color: {r: 0, g: 0.5, b: 0, a: 1}
        textAlignment: 0
