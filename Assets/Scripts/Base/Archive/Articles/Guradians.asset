    - rid: 6553496767108218968
      type: {class: ArticlePartText, ns: , asm: Assembly-CSharp}
      data:
        text: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 - \u044D\u0442\u043E
          \u0440\u043E\u0431\u043E\u0442\u044B \u0442\u0438\u043F\u0430 \"\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A-2\",
          \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0446\u0438\u044F
          \u043C\u0430\u0441\u0441\u043E\u0432\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
          \u0434\u043B\u044F \u043E\u0445\u0440\u0430\u043D\u044B \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439.
          \u041E\u043D\u0438 \u0445\u043E\u0434\u044F\u0442 \u043F\u043E \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u043C\u0443
          \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443 \u0438 \u0441\u043A\u0430\u043D\u0438\u0440\u0443\u044E\u0442
          \u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435
          \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445 \u043B\u0438\u0446,
          \u0438 \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u0438\u0445 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0438\u044F
          \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u044E\u0442 \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044E."
